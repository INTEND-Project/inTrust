#!/bin/bash
# ============================================================================
# Slurm job: self-contained benchmark campaign on ds01 (recommended).
#
# Allocates one GPU, starts Ollama INSIDE the allocation, waits until the
# API answers, pulls the models of the selected experiment, runs the
# benchmark campaign, and shuts Ollama down again.  Because everything
# happens inside one job, the campaign survives SSH disconnects and needs
# no interaction.
#
# Before first use:
#   1. Change the --output path below and the REPO_DIR variable to YOUR
#      home directory / repository clone.
#   2. Make sure the log directory exists:  mkdir -p ~/logs/slurm
#
# Submit (defaults: scaling_study):
#   sbatch benchmark/slurm/run_campaign.job
#
# Override the experiment or add CLI flags without editing the file:
#   sbatch --export=ALL,EXPERIMENT=family_comparison benchmark/slurm/run_campaign.job
#   sbatch --export=ALL,EXPERIMENT=scaling_study,EXTRA_ARGS="--runs 5" \
#          benchmark/slurm/run_campaign.job
#
# The models to pull are derived automatically from the config file for the
# selected experiment, so the pull list can never diverge from what the
# benchmark will actually request.
#
# Results land in $REPO_DIR/results/ exactly as in a local run; plots and
# LaTeX tables can be (re)generated afterwards on any machine.
# ============================================================================
#SBATCH --output /home/rustemd/logs/slurm/benchmark_%j.out
#SBATCH --job-name intrust/benchmark
#SBATCH --partition sintef
#SBATCH --ntasks 1
#SBATCH --mem=32GB
#SBATCH --cpus-per-task=8
#SBATCH --gres gpu:a30:1
#SBATCH --time 00-24:00:00

# ---- parameters (override via sbatch --export=ALL,NAME=value) --------------
REPO_DIR="${REPO_DIR:-/home/rustemd/SOCC/inTrust}"
# Python environment: CONDA_ENV (a conda environment name) takes precedence;
# set CONDA_ENV="" and VENV=/path/to/venv to use a classic virtualenv instead.
CONDA_ENV="${CONDA_ENV:-venv}"
VENV="${VENV:-${REPO_DIR}/venv}"
# Ollama binary.  Override with a user-local install when the system Ollama
# is too old for the benchmark models (see README, "Using a newer Ollama"):
#   sbatch --export=ALL,OLLAMA_BIN=$HOME/ollama/bin/ollama ...
OLLAMA_BIN="${OLLAMA_BIN:-ollama}"
PORT="${PORT:-33111}"
EXPERIMENT="${EXPERIMENT:-scaling_study}"
# Optional alternative config file, passed to run_benchmark as --config.
CONFIG="${CONFIG:-}"
# Models to pull before the campaign (space-separated Ollama tags).
# "auto" (default) reads the model list of $EXPERIMENT from the config so the
# pulls always match what the benchmark will request.
MODELS="${MODELS:-auto}"
# Extra CLI flags for run_benchmark.py, e.g. "--runs 5 --warmup 1".
EXTRA_ARGS="${EXTRA_ARGS:-}"

echo ""
echo "***** LAUNCHING *****"
date '+%F %H:%M:%S'
echo "Repo:       ${REPO_DIR}"
echo "Experiment: ${EXPERIMENT}"
echo "Ollama API: http://127.0.0.1:${PORT}"
# Record which Ollama serves this campaign (methodology provenance).
echo "Ollama bin: ${OLLAMA_BIN} ($("${OLLAMA_BIN}" --version 2>&1))"
echo ""

# ---- activate the Python environment ----------------------------------------
# 'conda activate' needs conda's shell hook first because batch jobs run a
# non-interactive shell (no .bashrc).
cd "${REPO_DIR}"
if [ -n "${CONDA_ENV}" ]; then
    source "$(conda info --base)/etc/profile.d/conda.sh"
    conda activate "${CONDA_ENV}"
elif [ -n "${VENV}" ]; then
    source "${VENV}/bin/activate"
fi
echo "Using python: $(which python)"

# ---- start Ollama in the background inside this allocation -----------------
export OLLAMA_HOST=127.0.0.1:${PORT}
# See ollama_serve.job for why these two matter for the benchmark.
export OLLAMA_NUM_PARALLEL=4
export OLLAMA_KEEP_ALIVE=30m

mkdir -p "${REPO_DIR}/results"
"${OLLAMA_BIN}" serve > "${REPO_DIR}/results/ollama_serve_${SLURM_JOB_ID}.log" 2>&1 &
OLLAMA_PID=$!
# Always shut Ollama down when the job ends, whatever happens in between.
trap 'kill ${OLLAMA_PID} 2>/dev/null' EXIT

# Wait (up to 60 s) for the API to come up before doing anything else.
for i in $(seq 1 60); do
    if curl -s --max-time 2 "http://127.0.0.1:${PORT}/api/version" > /dev/null; then
        echo "Ollama is up (after ${i}s)."
        break
    fi
    if [ "$i" -eq 60 ]; then
        echo "ERROR: Ollama did not come up within 60 s — aborting." >&2
        exit 1
    fi
    sleep 1
done

# ---- resolve and pull the models of this experiment --------------------------
if [ "${MODELS}" = "auto" ]; then
    MODELS=$(python - <<PYEOF
from benchmark.config import load_config
cfg = load_config("${CONFIG}" or None)
models = cfg.experiments["${EXPERIMENT}"].models
# Strip ONLY the litellm provider prefix ("ollama_chat/qwen3:8b" ->
# "qwen3:8b").  Namespaced community models keep their namespace
# ("ollama_chat/orieg/gemma3-tools:12b" -> "orieg/gemma3-tools:12b").
print(" ".join(m.removeprefix("ollama_chat/") for m in models))
PYEOF
    ) || { echo "ERROR: could not read model list from config." >&2; exit 1; }
fi
echo "Models: ${MODELS}"

# Pulling up front keeps download time out of the benchmark process entirely
# (a pull is a no-op when the model is already present).
for model in ${MODELS}; do
    echo "Pulling ${model} ..."
    "${OLLAMA_BIN}" pull "${model}"
done

# ---- run the campaign --------------------------------------------------------
# Point the benchmark at this job's Ollama port without editing the config.
export INTRUST_OLLAMA_API_BASE="http://127.0.0.1:${PORT}"

if [ -n "${CONFIG}" ]; then
    python -m benchmark.run_benchmark --config "${CONFIG}" \
        --experiment "${EXPERIMENT}" ${EXTRA_ARGS}
else
    python -m benchmark.run_benchmark --experiment "${EXPERIMENT}" ${EXTRA_ARGS}
fi
STATUS=$?

echo ""
echo "***** DONE (exit ${STATUS}) *****"
date '+%F %H:%M:%S'
echo ""
exit ${STATUS}
