#################################################################
# Metric definitions and severity thresholds per assessment skill
#
# Thresholds are declared here rather than inferred during report
# authoring, so that the severity of a metric observation is a derived
# and reviewable property.  A normalizer reads spa:metricIdentifier to
# bind a raw tool output column to its definition, then classifies each
# observation by the first matching threshold in descending order.
#################################################################

spa:MembershipInferenceAdvantageMetric
    rdf:type owl:NamedIndividual , spa:MetricDefinition ;
    rdfs:label "Membership inference attack advantage"@en ;
    spa:metricIdentifier "membershipInferenceAdvantage" ;
    spa:metricDefinitionText "The advantage of a membership inference adversary over random guessing, reported by the MIA service as the 'adv' column. Zero indicates no advantage; magnitude indicates how reliably training-set membership can be inferred. Sign is taken to indicate the direction of the adversary's bias rather than a measure of severity, so classification uses the absolute value; that reading is not itself confirmed — see spa:metricSemanticsProvisionalReason." ;
    spa:metricUnit "advantage" ;
    spa:higherIsWorse true ;
    spa:aggregationFunction "maximum" ;
    spa:metricSemanticsProvisional true ;
    spa:metricSemanticsProvisionalReason "Whether the sign of the 'adv' column is directional — the way the adversary's bias runs — or is measurement noise around zero has not been confirmed with the team that owns the MIA attack implementation. Classification uses the absolute value, which is the conservative reading: it treats a negative advantage as a leak of the same size as its positive counterpart. If the sign turns out to be noise, findings resting on a negative value are overstated; the magnitudes themselves are the tool's and are unaffected." ;
    spa:hasThreshold spa:MIAAdvantageHighThreshold ,
                     spa:MIAAdvantageMediumThreshold ,
                     spa:MIAAdvantageLowThreshold .

spa:MembershipInferenceAttackAccuracyMetric
    rdf:type owl:NamedIndividual , spa:MetricDefinition ;
    rdfs:label "Membership inference attack accuracy score"@en ;
    spa:metricIdentifier "membershipInferenceScore" ;
    spa:metricDefinitionText "The MIA service 'score' column. In the observed MIA output this is an exact algebraic restatement of the attack advantage, not an independent measurement, and it moves inversely: it falls away from 0.5 as the advantage grows. It is retained for traceability to the raw tool output and must not be presented as corroborating evidence alongside the advantage." ;
    spa:metricUnit "accuracy" ;
    spa:higherIsWorse false ;
    spa:derivedFromMetric spa:MembershipInferenceAdvantageMetric ;
    spa:derivationExpression "(1 - abs(adv)) / 2" .

spa:MIAAdvantageHighThreshold
    rdf:type owl:NamedIndividual , spa:Threshold ;
    rdfs:label "High membership inference advantage"@en ;
    spa:thresholdValue "0.10"^^xsd:decimal ;
    spa:comparisonOperator "greater-than-or-equal" ;
    spa:impliesSeverity spa:SeverityHigh ;
    rdfs:comment "An advantage at or above 0.10 means the adversary is right about training-set membership in roughly 55 of 100 attempts against a 50 baseline, which is a reportable privacy leak. Confirmed with the team that owns the MIA attack implementation."@en .

spa:MIAAdvantageMediumThreshold
    rdf:type owl:NamedIndividual , spa:Threshold ;
    rdfs:label "Medium membership inference advantage"@en ;
    spa:thresholdValue "0.05"^^xsd:decimal ;
    spa:comparisonOperator "greater-than-or-equal" ;
    spa:impliesSeverity spa:SeverityMedium ;
    rdfs:comment "An advantage in the 0.05 to 0.10 band is a measurable but limited leak. Confirmed with the team that owns the MIA attack implementation."@en .

spa:MIAAdvantageLowThreshold
    rdf:type owl:NamedIndividual , spa:Threshold ;
    rdfs:label "Low membership inference advantage"@en ;
    spa:thresholdValue "0.02"^^xsd:decimal ;
    spa:comparisonOperator "greater-than-or-equal" ;
    spa:impliesSeverity spa:SeverityLow ;
    rdfs:comment "An advantage in the 0.02 to 0.05 band is at or near measurement noise for a sweep of this size, recorded for completeness rather than as an actionable leak. Confirmed with the team that owns the MIA attack implementation."@en .

#################################################################
# Compliance requirement individuals
#
# These bind a regulatory source to the specific obligation an InTrust
# skill can produce evidence for, via spa:evaluatedBySkill.  A criterion
# named in an intent is only "covered" when at least one of its
# requirements is evaluable by the skill that ran; otherwise the report
# must say the criterion was named but not assessed.  Declaring the link
# here keeps that distinction reviewable instead of implied.
#################################################################

spa:GDPRSecurityOfProcessing
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Security of processing (GDPR Art. 32)"@en ;
    spa:identifier "GDPR-Art32" ;
    spa:description "Controllers and processors shall implement measures appropriate to the risk, including measures to ensure the ongoing confidentiality of personal data being processed." ;
    spa:sourceReference "Regulation (EU) 2016/679, Article 32" ;
    spa:derivedFromSource spa:GDPR ;
    spa:evaluatedBySkill "mia-privacy" ;
    spa:addressesPrivacyThreatCategory spa:DisclosureOfInformation .

spa:GDPRDataProtectionByDesign
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Data protection by design and by default (GDPR Art. 25)"@en ;
    spa:identifier "GDPR-Art25" ;
    spa:description "Technical and organisational measures shall be implemented, at the time of determining the means of processing, to give effect to the data protection principles." ;
    spa:sourceReference "Regulation (EU) 2016/679, Article 25" ;
    spa:derivedFromSource spa:GDPR ;
    spa:evaluatedBySkill "mia-privacy" ;
    spa:addressesPrivacyThreatCategory spa:Identifiability .

spa:GDPRDataSubjectRights
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Data subject rights (GDPR Ch. III)"@en ;
    spa:identifier "GDPR-ChIII" ;
    spa:description "Data subjects have rights of access, rectification, erasure, restriction, portability and objection, which a controller must be able to give effect to." ;
    spa:sourceReference "Regulation (EU) 2016/679, Chapter III" ;
    spa:derivedFromSource spa:GDPR ;
    spa:addressesPrivacyThreatCategory spa:Unawareness .

spa:GDPRLawfulnessOfProcessing
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Lawfulness of processing (GDPR Art. 6)"@en ;
    spa:identifier "GDPR-Art6" ;
    spa:description "Processing is lawful only if and to the extent that at least one legal basis applies." ;
    spa:sourceReference "Regulation (EU) 2016/679, Article 6" ;
    spa:derivedFromSource spa:GDPR ;
    spa:addressesPrivacyThreatCategory spa:NonCompliance .

spa:GDPRTestingOfSecurityMeasures
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Testing and evaluating the effectiveness of security measures (GDPR Art. 32(1)(d))"@en ;
    spa:identifier "GDPR-Art32-1d" ;
    spa:description "A process for regularly testing, assessing and evaluating the effectiveness of technical and organisational measures for ensuring the security of processing." ;
    spa:sourceReference "Regulation (EU) 2016/679, Article 32(1)(d)" ;
    spa:derivedFromSource spa:GDPR ;
    spa:evaluatedBySkill "bandit-static-code" ;
    spa:evaluatedBySkill "trivy-filesystem" ;
    spa:evaluatedBySkill "trivy-docker-image" ;
    spa:evaluatedBySkill "trivy-kubernetes" ;
    spa:evaluatedBySkill "mia-privacy" ;
    rdfs:comment "Declared separately from spa:GDPRSecurityOfProcessing rather than folded into it. Article 32(1) requires measures appropriate to the risk; 32(1)(d) requires that they be tested. A scan evidences the testing obligation — it ran, and it says what it looked for — but it does not establish that the measures a controller chose are appropriate, which is a judgement no tool in this framework makes. Keeping the two apart is what stops a passing scan from reading as compliance with Article 32 as a whole."@en .

#################################################################
# Security requirement individuals
#
# Distinct from the privacy requirements above in what evidences them: a
# scanner reports the presence of a known weakness in an artifact, whereas
# the MIA sweep measures a property of a trained model.  Both are declared
# here so that criterion resolution stays a lookup, but the skill lists are
# deliberately narrow — a requirement is only listed as evaluable by a skill
# whose output bears on that specific obligation.  Where the obligation is
# organisational (a policy must exist, a process must be followed), no skill
# is named, and coverage resolution will say so.
#################################################################

spa:NIS2VulnerabilityHandling
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Vulnerability handling and disclosure (NIS2 Art. 21(2)(e))"@en ;
    spa:identifier "NIS2-Art21-2e" ;
    spa:description "Security in network and information systems acquisition, development and maintenance, including vulnerability handling and disclosure." ;
    spa:sourceReference "Directive (EU) 2022/2555, Article 21(2)(e)" ;
    spa:derivedFromSource spa:NIS2 ;
    spa:evaluatedBySkill "bandit-static-code" ;
    spa:evaluatedBySkill "trivy-filesystem" ;
    spa:evaluatedBySkill "trivy-docker-image" ;
    spa:evaluatedBySkill "trivy-kubernetes" .

spa:NIS2RiskAnalysisPolicies
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Risk analysis and information system security policies (NIS2 Art. 21(2)(a))"@en ;
    spa:identifier "NIS2-Art21-2a" ;
    spa:description "Policies on risk analysis and information system security." ;
    spa:sourceReference "Directive (EU) 2022/2555, Article 21(2)(a)" ;
    spa:derivedFromSource spa:NIS2 ;
    rdfs:comment "No skill is named: whether a policy exists and is adequate is not something a scan can show. An assessment result may be evidence used within such a policy, but it does not evidence the policy."@en .

spa:NIS2SupplyChainSecurity
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Supply chain security (NIS2 Art. 21(2)(d))"@en ;
    spa:identifier "NIS2-Art21-2d" ;
    spa:description "Supply chain security, including security-related aspects of the relationships between each entity and its direct suppliers or service providers." ;
    spa:sourceReference "Directive (EU) 2022/2555, Article 21(2)(d)" ;
    spa:derivedFromSource spa:NIS2 ;
    spa:evaluatedBySkill "trivy-filesystem" ;
    spa:evaluatedBySkill "trivy-docker-image" ;
    rdfs:comment "Named for the Trivy skills only, and only in part: they enumerate third-party components and report published vulnerabilities in them, which bears on the technical half of this obligation. The supplier relationship itself is outside anything the framework observes. Bandit is not named — it analyses first-party source and does not inspect dependencies."@en .

spa:NIS2CryptographyPolicy
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Policies on the use of cryptography (NIS2 Art. 21(2)(h))"@en ;
    spa:identifier "NIS2-Art21-2h" ;
    spa:description "Policies and procedures regarding the use of cryptography and, where appropriate, encryption." ;
    spa:sourceReference "Directive (EU) 2022/2555, Article 21(2)(h)" ;
    spa:derivedFromSource spa:NIS2 ;
    spa:evaluatedBySkill "bandit-static-code" ;
    rdfs:comment "Bandit detects use of broken hash functions and insecure cipher modes, which is evidence about cryptographic practice in the code scanned. It says nothing about key management, transport configuration, or whether a policy exists."@en .

spa:ISO27001SecureCoding
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Secure coding (ISO/IEC 27001 A.8.28)"@en ;
    spa:identifier "ISO27001-A.8.28" ;
    spa:description "Secure coding principles shall be applied to software development." ;
    spa:sourceReference "ISO/IEC 27001:2022, Annex A control 8.28" ;
    spa:derivedFromSource spa:ISO27001 ;
    spa:evaluatedBySkill "bandit-static-code" .

spa:ISO27001TechnicalVulnerabilityManagement
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Management of technical vulnerabilities (ISO/IEC 27001 A.8.8)"@en ;
    spa:identifier "ISO27001-A.8.8" ;
    spa:description "Information about technical vulnerabilities of information systems in use shall be obtained, the exposure to such vulnerabilities evaluated, and appropriate measures taken." ;
    spa:sourceReference "ISO/IEC 27001:2022, Annex A control 8.8" ;
    spa:derivedFromSource spa:ISO27001 ;
    spa:evaluatedBySkill "trivy-filesystem" ;
    spa:evaluatedBySkill "trivy-docker-image" ;
    spa:evaluatedBySkill "trivy-kubernetes" ;
    spa:evaluatedBySkill "bandit-static-code" .

spa:ISO27001AuthenticationInformation
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Authentication information (ISO/IEC 27001 A.5.17)"@en ;
    spa:identifier "ISO27001-A.5.17" ;
    spa:description "Allocation and management of authentication information shall be controlled, including by requiring users to maintain the confidentiality of such information." ;
    spa:sourceReference "ISO/IEC 27001:2022, Annex A control 5.17" ;
    spa:derivedFromSource spa:ISO27001 ;
    spa:evaluatedBySkill "bandit-static-code" ;
    spa:evaluatedBySkill "trivy-filesystem" ;
    rdfs:comment "Both skills detect credentials committed to source, which is a specific failure of this control. An absence of such findings is not evidence that authentication information is well managed elsewhere — only that none was found where these skills looked."@en .

spa:ISO27001SecureSystemArchitecture
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Secure system architecture and engineering principles (ISO/IEC 27001 A.8.27)"@en ;
    spa:identifier "ISO27001-A.8.27" ;
    spa:description "Principles for engineering secure systems shall be established, documented, maintained and applied to information system development activities." ;
    spa:sourceReference "ISO/IEC 27001:2022, Annex A control 8.27" ;
    spa:derivedFromSource spa:ISO27001 ;
    spa:evaluatedBySkill "trivy-kubernetes" ;
    rdfs:comment "Named for the Kubernetes skill because its misconfiguration checks test deployment-time hardening decisions — privilege, capabilities, network exposure — which is where engineering principles become observable. Whether the principles are documented is not assessed."@en .

spa:ISO27001ConfigurationManagement
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Configuration management (ISO/IEC 27001 A.8.9)"@en ;
    spa:identifier "ISO27001-A.8.9" ;
    spa:description "Configurations, including security configurations, of hardware, software, services and networks shall be established, documented, implemented, monitored and reviewed." ;
    spa:sourceReference "ISO/IEC 27001:2022, Annex A control 8.9" ;
    spa:derivedFromSource spa:ISO27001 ;
    spa:evaluatedBySkill "trivy-kubernetes" ;
    spa:evaluatedBySkill "trivy-docker-image" ;
    spa:evaluatedBySkill "trivy-filesystem" .

spa:NISTCSFVulnerabilityIdentification
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Vulnerabilities in assets are identified and recorded (NIST CSF ID.RA-01)"@en ;
    spa:identifier "NIST-CSF-ID.RA-01" ;
    spa:description "Vulnerabilities in assets are identified, validated and recorded." ;
    spa:sourceReference "NIST Cybersecurity Framework 2.0, subcategory ID.RA-01" ;
    spa:derivedFromSource spa:NISTCSF ;
    spa:evaluatedBySkill "bandit-static-code" ;
    spa:evaluatedBySkill "trivy-filesystem" ;
    spa:evaluatedBySkill "trivy-docker-image" ;
    spa:evaluatedBySkill "trivy-kubernetes" ;
    spa:evaluatedBySkill "mia-privacy" .

spa:NISTCSFSecureDevelopment
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Secure software development practices are integrated (NIST CSF PR.PS-06)"@en ;
    spa:identifier "NIST-CSF-PR.PS-06" ;
    spa:description "Secure software development practices are integrated, and their performance is monitored throughout the software development life cycle." ;
    spa:sourceReference "NIST Cybersecurity Framework 2.0, subcategory PR.PS-06" ;
    spa:derivedFromSource spa:NISTCSF ;
    spa:evaluatedBySkill "bandit-static-code" .

spa:DORAICTVulnerabilityDetection
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Identification and assessment of ICT vulnerabilities (DORA Art. 10)"@en ;
    spa:identifier "DORA-Art10" ;
    spa:description "Financial entities shall have mechanisms to promptly detect anomalous activities and ICT vulnerabilities affecting ICT systems supporting critical or important functions." ;
    spa:sourceReference "Regulation (EU) 2022/2554, Article 10" ;
    spa:derivedFromSource spa:DORA ;
    spa:evaluatedBySkill "trivy-filesystem" ;
    spa:evaluatedBySkill "trivy-docker-image" ;
    spa:evaluatedBySkill "trivy-kubernetes" ;
    spa:evaluatedBySkill "bandit-static-code" ;
    rdfs:comment "Whether the systems scanned support a critical or important function is a determination the entity makes, not one this framework observes. A result under this requirement evidences that a detection mechanism ran against the artifact given to it."@en .

#################################################################
# Requirements no skill in this framework can evidence
#
# Declared deliberately, and with no spa:evaluatedBySkill.  Criterion
# resolution reports a source as fully covered when every requirement under
# it is evaluable, so a source represented here by only the one obligation a
# scanner happens to satisfy would resolve as complete coverage of a
# regulation — DORA read as met because a vulnerability scan ran.  These
# individuals make the remainder of each source visible, so the coverage
# statement carries "evidence bearing on 1 of 4 requirements" rather than
# silence.  They are the honest half of the mapping above.
#################################################################

spa:DORAICTRiskManagementFramework
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "ICT risk management framework (DORA Art. 6)"@en ;
    spa:identifier "DORA-Art6" ;
    spa:description "Financial entities shall have a sound, comprehensive and well-documented ICT risk management framework, subject to internal audit, as part of their overall risk management system." ;
    spa:sourceReference "Regulation (EU) 2022/2554, Article 6" ;
    spa:derivedFromSource spa:DORA ;
    rdfs:comment "Governance and documentation. Nothing in an automated assessment result bears on whether such a framework exists or is audited."@en .

spa:DORAThreatLedPenetrationTesting
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Advanced testing based on threat-led penetration testing (DORA Art. 26)"@en ;
    spa:identifier "DORA-Art26" ;
    spa:description "Financial entities identified as significant shall carry out advanced testing by means of threat-led penetration testing at least every three years." ;
    spa:sourceReference "Regulation (EU) 2022/2554, Article 26" ;
    spa:derivedFromSource spa:DORA ;
    rdfs:comment "Explicitly not satisfied by the scanning skills, and worth stating rather than omitting. Threat-led penetration testing is adversarial and human-led; a static or database-driven scan is the baseline testing of Article 25, not this."@en .

spa:DORAIncidentReporting
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Reporting of major ICT-related incidents (DORA Art. 19)"@en ;
    spa:identifier "DORA-Art19" ;
    spa:description "Financial entities shall report major ICT-related incidents to the relevant competent authority within the specified time limits." ;
    spa:sourceReference "Regulation (EU) 2022/2554, Article 19" ;
    spa:derivedFromSource spa:DORA ;
    rdfs:comment "An operational reporting obligation. A finding is not an incident, and this framework observes nothing about reporting."@en .

spa:NISTCSFRiskManagementObjectives
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Risk management objectives are established and agreed (NIST CSF GV.RM-01)"@en ;
    spa:identifier "NIST-CSF-GV.RM-01" ;
    spa:description "Risk management objectives are established and agreed to by organizational stakeholders." ;
    spa:sourceReference "NIST Cybersecurity Framework 2.0, subcategory GV.RM-01" ;
    spa:derivedFromSource spa:NISTCSF ;
    rdfs:comment "Governance. An assessment can inform these objectives but cannot evidence that they were established or agreed."@en .

spa:NISTCSFVulnerabilityRemediation
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Vulnerabilities are remediated (NIST CSF ID.RA-06)"@en ;
    spa:identifier "NIST-CSF-ID.RA-06" ;
    spa:description "Risk responses are chosen, prioritized, planned, tracked and communicated." ;
    spa:sourceReference "NIST Cybersecurity Framework 2.0, subcategory ID.RA-06" ;
    spa:derivedFromSource spa:NISTCSF ;
    rdfs:comment "The framework identifies and it recommends, but it does not observe whether a response was chosen or carried out. Naming a skill here would let a report that lists unfixed HIGH findings simultaneously claim the remediation subcategory as assessed."@en .

spa:ISO27001InformationSecurityPolicies
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Policies for information security (ISO/IEC 27001 A.5.1)"@en ;
    spa:identifier "ISO27001-A.5.1" ;
    spa:description "Information security policy and topic-specific policies shall be defined, approved by management, published, communicated to and acknowledged by relevant personnel." ;
    spa:sourceReference "ISO/IEC 27001:2022, Annex A control 5.1" ;
    spa:derivedFromSource spa:ISO27001 ;
    rdfs:comment "Organisational. No scan result bears on whether a policy is defined, approved or communicated."@en .

spa:NIS2IncidentHandling
    rdf:type owl:NamedIndividual , spa:ComplianceRequirement ;
    rdfs:label "Incident handling (NIS2 Art. 21(2)(b))"@en ;
    spa:identifier "NIS2-Art21-2b" ;
    spa:description "Incident handling." ;
    spa:sourceReference "Directive (EU) 2022/2555, Article 21(2)(b)" ;
    spa:derivedFromSource spa:NIS2 ;
    rdfs:comment "A process obligation, unobservable from an assessment result."@en .

#################################################################
# Regulatory and standard source individuals
#################################################################

spa:GDPR
    rdf:type owl:NamedIndividual , spa:Regulation ;
    rdfs:label "General Data Protection Regulation"@en ;
    spa:identifier "GDPR" ;
    spa:criterionKey "gdpr" ;
    spa:sourceReference "Regulation (EU) 2016/679" .

spa:NIS2
    rdf:type owl:NamedIndividual , spa:Regulation ;
    rdfs:label "NIS2 Directive"@en ;
    spa:identifier "NIS2" ;
    spa:criterionKey "nis2" ;
    spa:sourceReference "Directive (EU) 2022/2555" .

spa:DORA
    rdf:type owl:NamedIndividual , spa:Regulation ;
    rdfs:label "Digital Operational Resilience Act"@en ;
    spa:identifier "DORA" ;
    spa:criterionKey "dora" ;
    spa:sourceReference "Regulation (EU) 2022/2554" .

spa:ISO27001
    rdf:type owl:NamedIndividual , spa:Standard ;
    rdfs:label "ISO/IEC 27001"@en ;
    spa:identifier "ISO/IEC 27001" ;
    spa:criterionKey "iso27001" ;
    spa:sourceReference "ISO/IEC 27001 information security management systems" .

spa:NISTCSF
    rdf:type owl:NamedIndividual , spa:Standard ;
    rdfs:label "NIST Cybersecurity Framework"@en ;
    spa:identifier "NIST CSF" ;
    spa:criterionKey "nistcsf" ;
    spa:sourceReference "NIST Cybersecurity Framework" .

spa:TMForumTR2921
    rdf:type owl:NamedIndividual , spa:Standard ;
    rdfs:label "TM Forum TR 2921"@en ;
    spa:identifier "TMF TR2921" ;
    spa:criterionKey "tmf-tr2921" ;
    spa:sourceReference "TM Forum TR 2921 security-related technical report" .

spa:LINDDUNFramework
    rdf:type owl:NamedIndividual , spa:Standard ;
    rdfs:label "LINDDUN Privacy Threat Modeling Framework"@en ;
    spa:identifier "LINDDUN" ;
    spa:criterionKey "linddun" ;
    spa:sourceReference "LINDDUN privacy threat modeling framework" .

#################################################################
# SHACL validation shapes
#################################################################

spa:AssessmentShape
    rdf:type sh:NodeShape ;
    rdfs:label "Assessment shape"@en ;
    sh:targetClass spa:Assessment ;
    sh:property [
        sh:path spa:hasAssessmentState ;
        sh:class spa:AssessmentState ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:usesAssessmentMethod ;
        sh:class spa:AssessmentMethod ;
    ] ;
    sh:property [
        sh:path spa:assessesAsset ;
        sh:class spa:Asset ;
    ] .

spa:FindingShape
    rdf:type sh:NodeShape ;
    rdfs:label "Finding shape"@en ;
    sh:targetClass spa:Finding ;
    sh:property [
        sh:path spa:hasFindingStatus ;
        sh:class spa:FindingStatus ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:hasSeverity ;
        sh:class spa:Severity ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:hasEvidence ;
        sh:class spa:Evidence ;
    ] .

spa:RiskShape
    rdf:type sh:NodeShape ;
    rdfs:label "Risk shape"@en ;
    sh:targetClass spa:Risk ;
    sh:property [
        sh:path spa:hasRiskLevel ;
        sh:class spa:RiskLevel ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:hasLikelihood ;
        sh:class spa:Likelihood ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:hasImpact ;
        sh:class spa:Impact ;
        sh:maxCount 1 ;
    ] .

spa:ControlShape
    rdf:type sh:NodeShape ;
    rdfs:label "Control shape"@en ;
    sh:targetClass spa:Control ;
    sh:property [
        sh:path spa:hasControlStatus ;
        sh:class spa:ControlStatus ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:hasControlType ;
        sh:class spa:ControlType ;
        sh:maxCount 1 ;
    ] .

spa:EvidenceShape
    rdf:type sh:NodeShape ;
    rdfs:label "Evidence shape"@en ;
    sh:targetClass spa:Evidence ;
    sh:property [
        sh:path spa:evidenceCollectedAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:evidenceSourceSystem ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:evidenceURI ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:evidenceHash ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:evidenceFormat ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

spa:ThresholdShape
    rdf:type sh:NodeShape ;
    rdfs:label "Threshold shape"@en ;
    sh:targetClass spa:Threshold ;
    sh:property [
        sh:path spa:thresholdValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:comparisonOperator ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "less-than" "less-than-or-equal" "greater-than"
                "greater-than-or-equal" "equal" "not-equal" ) ;
    ] ;
    sh:property [
        sh:path spa:impliesSeverity ;
        sh:class spa:Severity ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:thresholdProvisional ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    # A threshold flagged provisional must say what is outstanding: the reason is
    # carried into the report, so a bare flag would tell a reader that the
    # severity is unconfirmed without telling them what would confirm it.
    sh:property [
        sh:path spa:thresholdProvisionalReason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "A threshold with spa:thresholdProvisional true must also carry spa:thresholdProvisionalReason." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:thresholdProvisional true .
                FILTER NOT EXISTS { $this spa:thresholdProvisionalReason ?reason }
            }
        """ ;
    ] .

spa:SweepDimensionShape
    rdf:type sh:NodeShape ;
    rdfs:label "Sweep dimension shape"@en ;
    sh:targetClass spa:SweepDimension ;
    sh:property [
        sh:path spa:dimensionName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:dimensionValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

spa:MetricShape
    rdf:type sh:NodeShape ;
    rdfs:label "Metric shape"@en ;
    sh:targetClass spa:Metric ;
    sh:property [
        sh:path spa:hasMetricDefinition ;
        sh:class spa:MetricDefinition ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:metricTimestamp ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:aggregationPeriod ;
        sh:datatype xsd:duration ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:metricValue ;
        sh:datatype xsd:decimal ;
    ] .

spa:MetricDefinitionShape
    rdf:type sh:NodeShape ;
    rdfs:label "Metric definition shape"@en ;
    sh:targetClass spa:MetricDefinition ;
    sh:property [
        sh:path spa:metricDefinitionText ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path spa:metricUnit ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:aggregationFunction ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:metricSemanticsProvisional ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    # Same requirement as ThresholdShape makes of a provisional boundary, for
    # the same reason: the reason text is carried into the report, and a bare
    # flag tells a reader the metric is open to interpretation without telling
    # them which reading was used or what would settle it.
    sh:property [
        sh:path spa:metricSemanticsProvisionalReason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "A metric definition with spa:metricSemanticsProvisional true must also carry spa:metricSemanticsProvisionalReason." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:metricSemanticsProvisional true .
                FILTER NOT EXISTS { $this spa:metricSemanticsProvisionalReason ?reason }
            }
        """ ;
    ] .

spa:IntentShape
    rdf:type sh:NodeShape ;
    rdfs:label "Intent shape"@en ;
    sh:targetClass spa:Intent ;
    sh:property [
        sh:path spa:intentStatement ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path spa:hasIntentState ;
        sh:class spa:IntentState ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:hasFulfillmentCondition ;
        sh:class spa:FulfillmentCondition ;
    ] .

spa:DerivedIntentShape
    rdf:type sh:NodeShape ;
    rdfs:label "Derived intent shape"@en ;
    sh:targetClass spa:DerivedIntent ;
    sh:property [
        sh:path spa:derivedFrom ;
        sh:class spa:Intent ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path spa:intentStatement ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

spa:PrivacyThreatShape
    rdf:type sh:NodeShape ;
    rdfs:label "Privacy threat shape"@en ;
    sh:targetClass spa:PrivacyThreat ;
    sh:property [
        sh:path spa:hasPrivacyThreatCategory ;
        sh:class spa:PrivacyThreatCategory ;
        sh:minCount 1 ;
    ] .

spa:RequirementShape
    rdf:type sh:NodeShape ;
    rdfs:label "Requirement shape"@en ;
    sh:targetClass spa:Requirement ;
    sh:property [
        sh:path spa:derivedFromSource ;
        sh:class spa:RegulatorySource ;
    ] .

spa:AssessmentReportShape
    rdf:type sh:NodeShape ;
    rdfs:label "Assessment report shape"@en ;
    sh:targetClass spa:AssessmentReport ;
    sh:property [
        sh:path spa:reportType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:status ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "SUCCESS" "FAILED" "INCONCLUSIVE" ) ;
    ] ;
    sh:property [
        sh:path spa:summary ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:intentId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:recommendations ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path spa:scopeLimitation ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path spa:findings ;
        sh:nodeKind sh:BlankNodeOrIRI ;
    ] ;
    sh:property [
        sh:path spa:provenance ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
    ] .

spa:ReportRenditionShape
    rdf:type sh:NodeShape ;
    rdfs:label "Report rendition shape"@en ;
    sh:targetClass spa:ReportRendition ;
    # The profile and the basis for choosing it are both required.  A rendition
    # is a defensible artifact only if a reader can see which audience it was
    # built for and why that audience was inferred; a detail level with no
    # recorded basis cannot be checked against the intent that asked for it.
    sh:property [
        sh:path spa:renditionProfile ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "technical" "management" "compliance" "external" ) ;
    ] ;
    sh:property [
        sh:path spa:renditionResolvedBy ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:disclosureClass ;
        sh:class spa:DisclosureClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:numericDisclosure ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "exact" "banded" "verdictOnly" ) ;
    ] ;
    # Reconciliation figures.  Constrained in shape but not required here: an
    # external statement must not carry them at all (see
    # spa:ExternalStatementShape), so the requirement is stated below for the
    # renditions it applies to rather than as a blanket minimum that the
    # external case would have to violate.
    sh:property [
        sh:path spa:canonicalWorstSeverity ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "NONE" "LOW" "MEDIUM" "HIGH" "CRITICAL" ) ;
    ] ;
    sh:property [
        sh:path spa:canonicalFindingCount ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
    ] ;
    # An internal or confidential rendition reduces the fact model — by a
    # severity floor, a finding cap, or a sweep aggregation — so it must carry
    # the figures that make the reduction visible.  A management view showing
    # two findings against a canonical count of nine is transparently a
    # selection; the same view without the count reads as a complete list.
    sh:sparql [
        sh:message "A rendition that is not an external statement must carry spa:canonicalWorstSeverity and spa:canonicalFindingCount so the reduction it applied can be reconciled against the assessment." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:disclosureClass ?class .
                FILTER (?class != spa:DisclosureExternal)
                FILTER (
                    NOT EXISTS { $this spa:canonicalWorstSeverity ?severity }
                    || NOT EXISTS { $this spa:canonicalFindingCount ?count }
                )
            }
        """ ;
    ] ;
    sh:property [
        sh:path spa:findingsOmitted ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
    ] ;
    # A rendition that omits findings cannot claim the canonical count as its
    # own: the two together are what make the omission visible.
    sh:sparql [
        sh:message "A rendition cannot omit more findings than the fact model contained (spa:findingsOmitted exceeds spa:canonicalFindingCount)." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:findingsOmitted ?omitted .
                $this spa:canonicalFindingCount ?total .
                FILTER (?omitted > ?total)
            }
        """ ;
    ] .

spa:ExternalStatementShape
    rdf:type sh:NodeShape ;
    rdfs:label "External statement shape"@en ;
    sh:targetClass spa:ExternalStatement ;
    sh:property [
        sh:path spa:renditionReleased ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:withheldBecause ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path spa:externalScopeStatement ;
        sh:datatype xsd:string ;
    ] ;
    # A released statement must carry its scope.  "No findings" is a property of
    # a search, not of a target: released without the bounds of that search, a
    # clean verdict reads as a broader claim than the assessment made.  This is
    # the release gate restated as a shape, so an artifact that reached storage
    # by some path other than project_external is still caught.
    sh:sparql [
        sh:message "A released external statement must carry at least one spa:externalScopeStatement; a clean verdict is only releasable alongside the bounds of the search that produced it." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:renditionReleased true .
                FILTER NOT EXISTS { $this spa:externalScopeStatement ?scope }
            }
        """ ;
    ] ;
    # A withheld statement must say why.  An unexplained absence is
    # indistinguishable from an assessment that was never run.
    sh:sparql [
        sh:message "A withheld external statement must carry at least one spa:withheldBecause reason." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:renditionReleased false .
                FILTER NOT EXISTS { $this spa:withheldBecause ?reason }
            }
        """ ;
    ] ;
    # An external statement carries no reconciliation figures.  Elsewhere they
    # are required, because they make a reduction visible; here they would be a
    # disclosure in their own right — a finding count is a measurement of the
    # target, and "9 findings, none released" tells an outside reader exactly
    # what the allowlist exists to withhold.  This is the one place where the
    # transparency that serves an internal reader works against the artifact.
    sh:sparql [
        sh:message "An external statement must not carry spa:canonicalWorstSeverity or spa:canonicalFindingCount; a count of what was found is itself a disclosure about the target." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                { $this spa:canonicalWorstSeverity ?severity }
                UNION
                { $this spa:canonicalFindingCount ?count }
            }
        """ ;
    ] ;
    # The verdict gate, restated for the case where a figure is present anyway:
    # a released statement asserts that nothing was found, so a canonical
    # severity above NONE contradicts the release itself.  Redundant against the
    # constraint above by construction, and kept because the two fail for
    # different reasons — one is a leak, the other is a false claim.
    sh:sparql [
        sh:message "An external statement must not be released for an assessment whose canonical worst severity is above NONE." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:renditionReleased true .
                $this spa:canonicalWorstSeverity ?severity .
                FILTER (?severity != "NONE")
            }
        """ ;
    ] ;
    # An external artifact carries no measurements, so an exact or banded
    # numeric disclosure on one is a contradiction in terms.
    sh:sparql [
        sh:message "An external statement must declare spa:numericDisclosure as verdictOnly." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:numericDisclosure ?disclosure .
                FILTER (?disclosure != "verdictOnly")
            }
        """ ;
    ] ;
    sh:property [
        sh:path spa:assessedOn ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:statementValidUntil ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spa:approvalState ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "pending" "approved" ) ;
        sh:message "An external statement's spa:approvalState must be pending or approved; a refused release is not released at all." ;
    ] ;
    # A released statement must be dated and must expire.  Without a date no
    # expiry can be computed, and an unexpiring statement is the failure this
    # constraint exists for: the assessed component keeps changing while the
    # artifact does not, so a claim with no end reads as a current one forever.
    sh:sparql [
        sh:message "A released external statement must carry both spa:assessedOn and spa:statementValidUntil; an undated statement cannot be shown to have expired, and so never does." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:renditionReleased true .
                FILTER (
                    NOT EXISTS { $this spa:assessedOn ?date }
                    || NOT EXISTS { $this spa:statementValidUntil ?until }
                )
            }
        """ ;
    ] ;
    # Expiry runs forward from the assessment, never backward.  Catches a
    # negative validity period and a validity date copied from the wrong field.
    sh:sparql [
        sh:message "An external statement's spa:statementValidUntil must be later than its spa:assessedOn." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:assessedOn ?date .
                $this spa:statementValidUntil ?until .
                FILTER (?until <= ?date)
            }
        """ ;
    ] ;
    # The approval requirement and the approval itself, checked against each
    # other.  A statement that advertises the requirement and is released
    # unapproved is the exact case the flag was supposed to prevent, and before
    # this constraint existed the flag was set on every released statement while
    # nothing consumed it.
    sh:sparql [
        sh:message "A released external statement that requires approval must record spa:approvalState as approved together with spa:approvedBy; advertising an approval requirement while releasing unapproved makes the flag a description rather than a control." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                $this spa:renditionReleased true .
                $this spa:requiresApprovalBeforeRelease true .
                FILTER (
                    NOT EXISTS { $this spa:approvalState "approved" }
                    || NOT EXISTS { $this spa:approvedBy ?approver }
                )
            }
        """ ;
    ] ;
    # An approval must say who gave it, whichever direction the pair is
    # incomplete in: an approver with no approval, or an approval with no
    # approver, are both unaccountable.
    sh:sparql [
        sh:message "An external statement recording spa:approvalState as approved must also record spa:approvedBy, and vice versa." ;
        sh:prefixes spa: ;
        sh:select """
            SELECT $this WHERE {
                {
                    $this spa:approvalState "approved" .
                    FILTER NOT EXISTS { $this spa:approvedBy ?approver }
                }
                UNION
                {
                    $this spa:approvedBy ?approver .
                    FILTER NOT EXISTS { $this spa:approvalState "approved" }
                }
            }
        """ ;
    ] .
