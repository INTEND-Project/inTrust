@prefix spa:      <https://intend-project.eu/ontology/spa#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .

#################################################################
# Ontology metadata
#################################################################

spa:
    rdf:type owl:Ontology ;
    rdfs:label "SPA Ontology"@en ;
    rdfs:comment "Security and Privacy Assessment Ontology for assessment, evidence, controls, risks, findings, metrics, baselines, regulatory traceability, LINDDUN privacy threats, TM Forum-inspired security properties, and declarative intent-driven closed-loop management."@en ;
    dcterms:title "Security and Privacy Assessment Ontology"@en ;
    dcterms:creator "Christian Schaefer" ;
    dcterms:issued "2025-01-01"^^xsd:date ;
    dcterms:modified "2026-05-27"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionIRI <https://intend-project.eu/ontology/spa/2.1.0> ;
    owl:versionInfo "2.1.0" ;
    dcterms:publisher "INTEND Project" ;
    dcterms:description "An OWL/Turtle ontology for autonomous security and privacy assessment, integrating TM Forum-aligned security property concepts, LINDDUN privacy threat categories, assessment roles and methods, evidence metadata, metric definitions and observations, SHACL validation, and TMF921-compatible declarative intents."@en .

#################################################################
# Core classes
#################################################################

spa:Assessment
    rdf:type owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "A structured activity that evaluates assets, controls, risks, requirements, metrics, findings, or compliance posture."@en .

spa:SecurityAssessment
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Assessment ;
    rdfs:label "Security Assessment"@en ;
    rdfs:comment "An assessment focused on security properties, risks, controls, threats, vulnerabilities, and related requirements."@en .

spa:PrivacyAssessment
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Assessment ;
    rdfs:label "Privacy Assessment"@en ;
    rdfs:comment "An assessment focused on privacy risks, personal data processing, data protection principles, and privacy threat categories."@en .

spa:ComplianceAssessment
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Assessment ;
    rdfs:label "Compliance Assessment"@en ;
    rdfs:comment "An assessment focused on conformance with legal, regulatory, contractual, or organizational requirements."@en .

spa:AssessmentMethod
    rdf:type owl:Class ;
    rdfs:label "Assessment Method"@en ;
    rdfs:comment "A method or technique used to conduct an assessment."@en .

spa:AssessmentState
    rdf:type owl:Class ;
    rdfs:label "Assessment State"@en ;
    rdfs:comment "A controlled lifecycle state of an assessment."@en .

spa:Role
    rdf:type owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:comment "A responsibility or function performed by an actor in the assessment or remediation lifecycle."@en .

spa:Actor
    rdf:type owl:Class ;
    rdfs:label "Actor"@en ;
    rdfs:comment "A person, organization, system, or component involved in assessment, evidence collection, control operation, or intent fulfillment."@en .

spa:Asset
    rdf:type owl:Class ;
    rdfs:label "Asset"@en ;
    rdfs:comment "An entity of value that may be assessed, protected, monitored, or affected by risks, threats, controls, and intents."@en .

spa:System
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Asset ;
    rdfs:label "System"@en ;
    rdfs:comment "A technical system, application, platform, or service that may be assessed."@en .

spa:DataAsset
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Asset ;
    rdfs:label "Data Asset"@en ;
    rdfs:comment "A data set, database, data flow, or information object relevant for security or privacy assessment."@en .

spa:PersonalData
    rdf:type owl:Class ;
    rdfs:subClassOf spa:DataAsset ;
    rdfs:label "Personal Data"@en ;
    rdfs:comment "Data relating to an identified or identifiable natural person."@en .

spa:ProcessingActivity
    rdf:type owl:Class ;
    rdfs:label "Processing Activity"@en ;
    rdfs:comment "An activity involving the collection, storage, use, disclosure, transfer, deletion, or other processing of data."@en .

spa:Property
    rdf:type owl:Class ;
    rdfs:label "Property"@en ;
    rdfs:comment "A security, privacy, compliance, or operational property that may be assessed, monitored, protected, or targeted by an intent."@en .

spa:SecurityProperty
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Property ;
    rdfs:label "Security Property"@en ;
    rdfs:comment "A property relevant to security, such as confidentiality, integrity, availability, accountability, authentication, authorization, or non-repudiation."@en .

spa:PrivacyProperty
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Property ;
    rdfs:label "Privacy Property"@en ;
    rdfs:comment "A property relevant to privacy or data protection, such as purpose limitation, data minimization, transparency, consent, or storage limitation."@en .

spa:Threat
    rdf:type owl:Class ;
    rdfs:label "Threat"@en ;
    rdfs:comment "A potential cause of unwanted impact on assets, properties, requirements, or stakeholders."@en .

spa:SecurityThreat
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Threat ;
    rdfs:label "Security Threat"@en ;
    rdfs:comment "A threat affecting security properties or security-relevant assets."@en .

spa:PrivacyThreat
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Threat ;
    rdfs:label "Privacy Threat"@en ;
    rdfs:comment "A threat affecting privacy properties, personal data, data subjects, or lawful processing."@en .

spa:PrivacyThreatCategory
    rdf:type owl:Class ;
    rdfs:label "Privacy Threat Category"@en ;
    rdfs:comment "A controlled category of privacy threat, including LINDDUN categories."@en .

spa:Vulnerability
    rdf:type owl:Class ;
    rdfs:label "Vulnerability"@en ;
    rdfs:comment "A weakness that may be exploited by a threat and may give rise to risk."@en .

spa:Risk
    rdf:type owl:Class ;
    rdfs:label "Risk"@en ;
    rdfs:comment "The effect of uncertainty on objectives, commonly associated with threats, vulnerabilities, assets, likelihood, and impact."@en .

spa:RiskLevel
    rdf:type owl:Class ;
    rdfs:label "Risk Level"@en ;
    rdfs:comment "A controlled qualitative classification of risk magnitude."@en .

spa:Severity
    rdf:type owl:Class ;
    rdfs:label "Severity"@en ;
    rdfs:comment "A controlled qualitative classification of finding or issue severity."@en .

spa:Likelihood
    rdf:type owl:Class ;
    rdfs:label "Likelihood"@en ;
    rdfs:comment "A controlled qualitative classification of the probability or frequency of risk occurrence."@en .

spa:Impact
    rdf:type owl:Class ;
    rdfs:label "Impact"@en ;
    rdfs:comment "A controlled qualitative classification of adverse consequence magnitude."@en .

spa:Control
    rdf:type owl:Class ;
    rdfs:label "Control"@en ;
    rdfs:comment "A safeguard, countermeasure, process, policy, or technical capability used to satisfy requirements or mitigate risks."@en .

spa:ControlType
    rdf:type owl:Class ;
    rdfs:label "Control Type"@en ;
    rdfs:comment "A controlled classification of controls, such as preventive, detective, corrective, compensating, or deterrent."@en .

spa:ControlStatus
    rdf:type owl:Class ;
    rdfs:label "Control Status"@en ;
    rdfs:comment "A controlled implementation or operational state of a control."@en .

spa:Requirement
    rdf:type owl:Class ;
    rdfs:label "Requirement"@en ;
    rdfs:comment "A statement of expected behavior, obligation, property, or constraint."@en .

spa:SecurityRequirement
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Requirement ;
    rdfs:label "Security Requirement"@en ;
    rdfs:comment "A requirement addressing security objectives or security properties."@en .

spa:PrivacyRequirement
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Requirement ;
    rdfs:label "Privacy Requirement"@en ;
    rdfs:comment "A requirement addressing privacy, data protection, or lawful processing objectives."@en .

spa:ComplianceRequirement
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Requirement ;
    rdfs:label "Compliance Requirement"@en ;
    rdfs:comment "A requirement derived from a regulation, standard, policy, contract, or framework."@en .

spa:BaselineRequirement
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Requirement ;
    rdfs:label "Baseline Requirement"@en ;
    rdfs:comment "A requirement that belongs to or operationalizes a baseline."@en .

spa:Baseline
    rdf:type owl:Class ;
    rdfs:label "Baseline"@en ;
    rdfs:comment "A set of expected controls, requirements, thresholds, or configurations used as an assessment reference."@en .

spa:RegulatorySource
    rdf:type owl:Class ;
    rdfs:label "Regulatory Source"@en ;
    rdfs:comment "A regulation, standard, framework, policy, or source document from which requirements may be derived."@en .

spa:Regulation
    rdf:type owl:Class ;
    rdfs:subClassOf spa:RegulatorySource ;
    rdfs:label "Regulation"@en ;
    rdfs:comment "A legally binding regulatory source."@en .

spa:Standard
    rdf:type owl:Class ;
    rdfs:subClassOf spa:RegulatorySource ;
    rdfs:label "Standard"@en ;
    rdfs:comment "A standard, guideline, or best-practice framework used as a source of requirements or controls."@en .

spa:Finding
    rdf:type owl:Class ;
    rdfs:label "Finding"@en ;
    rdfs:comment "A statement resulting from an assessment, such as a conformity result, non-conformity, observation, weakness, or gap."@en .

spa:FindingItem
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Finding ;
    rdfs:label "Finding Item"@en ;
    rdfs:comment "An individual finding or assessment result item."@en .

spa:Gap
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Finding ;
    rdfs:label "Gap"@en ;
    rdfs:comment "A finding indicating a difference between the current state and a required, expected, or baseline state."@en .

spa:FindingStatus
    rdf:type owl:Class ;
    rdfs:label "Finding Status"@en ;
    rdfs:comment "A controlled lifecycle state of a finding."@en .

spa:Evidence
    rdf:type owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:comment "Information used to substantiate assessments, findings, control evaluations, risk ratings, or compliance conclusions."@en .

spa:Metric
    rdf:type owl:Class ;
    rdfs:label "Metric"@en ;
    rdfs:comment "A measurable quantity, indicator, KPI, KQI, or observation used in assessments, baselines, controls, findings, or intents."@en .

spa:MetricDefinition
    rdf:type owl:Class ;
    rdfs:label "Metric Definition"@en ;
    rdfs:comment "A reusable definition of a metric, including its meaning, unit, aggregation semantics, and expected interpretation."@en .

spa:MetricObservation
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Metric ;
    rdfs:label "Metric Observation"@en ;
    rdfs:comment "A concrete observed or calculated metric value at a given time or over a given aggregation period."@en .

spa:Threshold
    rdf:type owl:Class ;
    rdfs:label "Threshold"@en ;
    rdfs:comment "A limit, boundary, or target value used to evaluate a metric, control, baseline, requirement, or fulfillment condition."@en .

spa:Intent
    rdf:type owl:Class ;
    rdfs:label "Intent"@en ;
    rdfs:comment "A declarative statement of desired outcome, expectation, or constraint to be fulfilled by a management system."@en .

spa:HighLevelIntent
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Intent ;
    rdfs:label "High-Level Intent"@en ;
    rdfs:comment "A business-level or stakeholder-level declarative statement of desired security, privacy, compliance, or operational outcome."@en .

spa:DerivedIntent
    rdf:type owl:Class ;
    rdfs:subClassOf spa:Intent ;
    rdfs:label "Derived Intent"@en ;
    rdfs:comment "A declarative intent derived from a higher-level intent. It expresses a desired outcome or constraint without prescribing procedural implementation steps, remaining compatible with TMF921-style intent management."@en .

spa:FulfillmentCondition
    rdf:type owl:Class ;
    rdfs:label "Fulfillment Condition"@en ;
    rdfs:comment "A condition that determines whether an intent, requirement, control, or target state is satisfied."@en .

spa:IntentState
    rdf:type owl:Class ;
    rdfs:label "Intent State"@en ;
    rdfs:comment "A controlled lifecycle state of an intent."@en .

spa:Trigger
    rdf:type owl:Class ;
    rdfs:label "Trigger"@en ;
    rdfs:comment "An event, condition, schedule, finding, risk, or metric change that may initiate assessment, reassessment, remediation, or intent handling."@en .

spa:RemediationAction
    rdf:type owl:Class ;
    rdfs:label "Remediation Action"@en ;
    rdfs:comment "An action, change, recommendation, or activity intended to address a finding, risk, gap, or non-compliance."@en .

spa:AssessmentReport
    rdf:type owl:Class ;
    rdfs:label "Assessment Report"@en ;
    rdfs:comment "A formal report document communicating the outcome of an assessment, aligned with TM Forum intent reporting (e.g. tmfIntentReport.v1). It carries the report type, terminal status, a human-readable summary, the findings produced, recommended remediations, and provenance back to the originating intent."@en .

spa:ReportRendition
    rdf:type owl:Class ;
    rdfs:label "Report Rendition"@en ;
    rdfs:comment "One audience's view of an assessment, produced by projecting the canonical fact model. A rendition selects and aggregates fields; it never recomputes a figure, so several renditions of one assessment cannot disagree. Modelled as its own class rather than as an AssessmentReport because the constraints differ: a report is validated for completeness, a rendition for whether the fields it carries are permitted to the audience it was built for."@en .

spa:ExternalStatement
    rdf:type owl:Class ;
    rdfs:subClassOf spa:ReportRendition ;
    rdfs:label "External Statement"@en ;
    rdfs:comment "A rendition intended to leave the organisation. Built by allowlist rather than by removing fields, and produced only for an assessment that satisfied every release gate; otherwise it records that it was withheld and why. Declared as a subclass so the rendition constraints apply to it as well as the external-specific ones."@en .

#################################################################
# Object properties
#################################################################

spa:assessesAsset
    rdf:type owl:ObjectProperty ;
    rdfs:label "assesses asset"@en ;
    rdfs:domain spa:Assessment ;
    rdfs:range spa:Asset ;
    rdfs:comment "Links an assessment to an asset being assessed."@en .

spa:assessesProperty
    rdf:type owl:ObjectProperty ;
    rdfs:label "assesses property"@en ;
    rdfs:domain spa:Assessment ;
    rdfs:range spa:Property ;
    rdfs:comment "Links an assessment to a property that is being assessed."@en .

spa:usesAssessmentMethod
    rdf:type owl:ObjectProperty ;
    rdfs:label "uses assessment method"@en ;
    rdfs:domain spa:Assessment ;
    rdfs:range spa:AssessmentMethod ;
    rdfs:comment "Links an assessment to the method used to perform it."@en .

spa:hasAssessmentState
    rdf:type owl:ObjectProperty ;
    rdfs:label "has assessment state"@en ;
    rdfs:domain spa:Assessment ;
    rdfs:range spa:AssessmentState ;
    rdfs:comment "Links an assessment to its lifecycle state."@en .

spa:performedBy
    rdf:type owl:ObjectProperty ;
    rdfs:label "performed by"@en ;
    rdfs:domain spa:Assessment ;
    rdfs:range spa:Actor ;
    rdfs:comment "Links an assessment to the actor that performs it."@en .

spa:hasRole
    rdf:type owl:ObjectProperty ;
    rdfs:label "has role"@en ;
    rdfs:domain spa:Actor ;
    rdfs:range spa:Role ;
    rdfs:comment "Links an actor to a role."@en .

spa:hasFinding
    rdf:type owl:ObjectProperty ;
    rdfs:label "has finding"@en ;
    rdfs:domain spa:Assessment ;
    rdfs:range spa:Finding ;
    rdfs:comment "Links an assessment to a resulting finding."@en .

spa:isFindingOf
    rdf:type owl:ObjectProperty ;
    owl:inverseOf spa:hasFinding ;
    rdfs:label "is finding of"@en ;
    rdfs:domain spa:Finding ;
    rdfs:range spa:Assessment ;
    rdfs:comment "Links a finding to the assessment that produced it."@en .

spa:hasFindingStatus
    rdf:type owl:ObjectProperty ;
    rdfs:label "has finding status"@en ;
    rdfs:domain spa:Finding ;
    rdfs:range spa:FindingStatus ;
    rdfs:comment "Links a finding to its lifecycle status."@en .

spa:hasSeverity
    rdf:type owl:ObjectProperty ;
    rdfs:label "has severity"@en ;
    rdfs:domain spa:Finding ;
    rdfs:range spa:Severity ;
    rdfs:comment "Links a finding to a severity classification."@en .

spa:hasEvidence
    rdf:type owl:ObjectProperty ;
    rdfs:label "has evidence"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Evidence ;
    rdfs:comment "Links an assessment, finding, control, risk, requirement, or metric to supporting evidence."@en .

spa:supportsFinding
    rdf:type owl:ObjectProperty ;
    rdfs:label "supports finding"@en ;
    rdfs:domain spa:Evidence ;
    rdfs:range spa:Finding ;
    rdfs:comment "Links evidence to a finding it supports."@en .

spa:producedByAssessment
    rdf:type owl:ObjectProperty ;
    rdfs:label "produced by assessment"@en ;
    rdfs:domain spa:Evidence ;
    rdfs:range spa:Assessment ;
    rdfs:comment "Links evidence to the assessment activity that produced or collected it."@en .

spa:collectedBy
    rdf:type owl:ObjectProperty ;
    rdfs:label "collected by"@en ;
    rdfs:domain spa:Evidence ;
    rdfs:range spa:Actor ;
    rdfs:comment "Links evidence to the actor that collected it."@en .

spa:relatesToAsset
    rdf:type owl:ObjectProperty ;
    rdfs:label "relates to asset"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Asset ;
    rdfs:comment "Links a finding, risk, evidence item, metric, threat, vulnerability, control, or intent to an asset."@en .

spa:affectsProperty
    rdf:type owl:ObjectProperty ;
    rdfs:label "affects property"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Property ;
    rdfs:comment "Links a threat, risk, finding, vulnerability, or control to an affected property."@en .

spa:hasThreat
    rdf:type owl:ObjectProperty ;
    rdfs:label "has threat"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Threat ;
    rdfs:comment "Links an asset, assessment, risk, or model element to a relevant threat."@en .

spa:hasPrivacyThreatCategory
    rdf:type owl:ObjectProperty ;
    rdfs:label "has privacy threat category"@en ;
    rdfs:domain spa:PrivacyThreat ;
    rdfs:range spa:PrivacyThreatCategory ;
    rdfs:comment "Classifies a privacy threat using a privacy threat category, including LINDDUN categories."@en .

spa:hasVulnerability
    rdf:type owl:ObjectProperty ;
    rdfs:label "has vulnerability"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Vulnerability ;
    rdfs:comment "Links an asset, risk, finding, or assessment to a vulnerability."@en .

spa:exploitsVulnerability
    rdf:type owl:ObjectProperty ;
    rdfs:label "exploits vulnerability"@en ;
    rdfs:domain spa:Threat ;
    rdfs:range spa:Vulnerability ;
    rdfs:comment "Links a threat to a vulnerability it may exploit."@en .

spa:hasRisk
    rdf:type owl:ObjectProperty ;
    rdfs:label "has risk"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Risk ;
    rdfs:comment "Links an assessment, asset, finding, threat, vulnerability, or requirement to a risk."@en .

spa:hasRiskLevel
    rdf:type owl:ObjectProperty ;
    rdfs:label "has risk level"@en ;
    rdfs:domain spa:Risk ;
    rdfs:range spa:RiskLevel ;
    rdfs:comment "Links a risk to a risk level classification."@en .

spa:hasLikelihood
    rdf:type owl:ObjectProperty ;
    rdfs:label "has likelihood"@en ;
    rdfs:domain spa:Risk ;
    rdfs:range spa:Likelihood ;
    rdfs:comment "Links a risk to a likelihood classification."@en .

spa:hasImpact
    rdf:type owl:ObjectProperty ;
    rdfs:label "has impact"@en ;
    rdfs:domain spa:Risk ;
    rdfs:range spa:Impact ;
    rdfs:comment "Links a risk to an impact classification."@en .

spa:mitigatesRisk
    rdf:type owl:ObjectProperty ;
    rdfs:label "mitigates risk"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Risk ;
    rdfs:comment "Links a control, remediation action, or intent to a risk it mitigates."@en .

spa:hasControl
    rdf:type owl:ObjectProperty ;
    rdfs:label "has control"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Control ;
    rdfs:comment "Links a baseline, requirement, assessment, risk, or asset to a control."@en .

spa:implementsRequirement
    rdf:type owl:ObjectProperty ;
    rdfs:label "implements requirement"@en ;
    rdfs:domain spa:Control ;
    rdfs:range spa:Requirement ;
    rdfs:comment "Links a control to a requirement it implements."@en .

spa:satisfiesRequirement
    rdf:type owl:ObjectProperty ;
    rdfs:label "satisfies requirement"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Requirement ;
    rdfs:comment "Links a control, evidence item, metric, finding, or intent to a requirement it satisfies."@en .

spa:derivedFromSource
    rdf:type owl:ObjectProperty ;
    rdfs:label "derived from source"@en ;
    rdfs:domain spa:Requirement ;
    rdfs:range spa:RegulatorySource ;
    rdfs:comment "Links a requirement to the regulatory, standard, contractual, or policy source from which it is derived."@en .

spa:hasRequirement
    rdf:type owl:ObjectProperty ;
    rdfs:label "has requirement"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Requirement ;
    rdfs:comment "Links a baseline, regulation, standard, assessment, asset, property, control, or intent to a requirement."@en .

spa:hasBaselineRequirement
    rdf:type owl:ObjectProperty ;
    rdfs:label "has baseline requirement"@en ;
    rdfs:domain spa:Baseline ;
    rdfs:range spa:BaselineRequirement ;
    rdfs:comment "Links a baseline to a baseline requirement."@en .

spa:hasControlStatus
    rdf:type owl:ObjectProperty ;
    rdfs:label "has control status"@en ;
    rdfs:domain spa:Control ;
    rdfs:range spa:ControlStatus ;
    rdfs:comment "Links a control to its implementation or operational status."@en .

spa:hasControlType
    rdf:type owl:ObjectProperty ;
    rdfs:label "has control type"@en ;
    rdfs:domain spa:Control ;
    rdfs:range spa:ControlType ;
    rdfs:comment "Links a control to its control type."@en .

spa:usesMetric
    rdf:type owl:ObjectProperty ;
    rdfs:label "uses metric"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Metric ;
    rdfs:comment "Links an assessment, control, finding, baseline, requirement, or intent to a metric used for evaluation."@en .

spa:isMetricUsedByAssessment
    rdf:type owl:ObjectProperty ;
    rdfs:label "is metric used by assessment"@en ;
    rdfs:domain spa:Metric ;
    rdfs:range spa:Assessment ;
    rdfs:comment "Links a metric to an assessment that uses it."@en .

spa:findingBasedOnMetric
    rdf:type owl:ObjectProperty ;
    rdfs:label "finding based on metric"@en ;
    rdfs:domain spa:Finding ;
    rdfs:range spa:Metric ;
    rdfs:comment "Links a finding to a metric that supports or justifies it."@en .

spa:metricSupportsFinding
    rdf:type owl:ObjectProperty ;
    owl:inverseOf spa:findingBasedOnMetric ;
    rdfs:label "metric supports finding"@en ;
    rdfs:domain spa:Metric ;
    rdfs:range spa:Finding ;
    rdfs:comment "Links a metric to a finding it supports."@en .

spa:hasMetricDefinition
    rdf:type owl:ObjectProperty ;
    rdfs:label "has metric definition"@en ;
    rdfs:domain spa:Metric ;
    rdfs:range spa:MetricDefinition ;
    rdfs:comment "Links a metric or metric observation to its reusable metric definition."@en .

spa:hasThreshold
    rdf:type owl:ObjectProperty ;
    rdfs:label "has threshold"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Threshold ;
    rdfs:comment "Links a metric, condition, baseline, requirement, or intent to a threshold."@en .

spa:impliesSeverity
    rdf:type owl:ObjectProperty ;
    rdfs:label "implies severity"@en ;
    rdfs:domain spa:Threshold ;
    rdfs:range spa:Severity ;
    rdfs:comment "The severity classification implied by a metric observation crossing this threshold. Declaring the mapping here makes severity a derived, reviewable property of the ontology rather than a judgement made during report authoring."@en .

spa:hasFulfillmentCondition
    rdf:type owl:ObjectProperty ;
    rdfs:label "has fulfillment condition"@en ;
    rdfs:domain spa:Intent ;
    rdfs:range spa:FulfillmentCondition ;
    rdfs:comment "Links an intent to a declarative condition used to determine fulfillment."@en .

spa:hasIntentState
    rdf:type owl:ObjectProperty ;
    rdfs:label "has intent state"@en ;
    rdfs:domain spa:Intent ;
    rdfs:range spa:IntentState ;
    rdfs:comment "Links an intent to its lifecycle state."@en .

spa:decomposesInto
    rdf:type owl:ObjectProperty ;
    rdfs:label "decomposes into"@en ;
    rdfs:domain spa:Intent ;
    rdfs:range spa:DerivedIntent ;
    rdfs:comment "Links a higher-level intent to one or more declarative derived intents."@en .

spa:derivedFrom
    rdf:type owl:ObjectProperty ;
    owl:inverseOf spa:decomposesInto ;
    rdfs:label "derived from"@en ;
    rdfs:domain spa:DerivedIntent ;
    rdfs:range spa:Intent ;
    rdfs:comment "Links a derived intent to the intent from which it was declaratively derived."@en .

spa:targetsAsset
    rdf:type owl:ObjectProperty ;
    rdfs:label "targets asset"@en ;
    rdfs:domain spa:Intent ;
    rdfs:range spa:Asset ;
    rdfs:comment "Links an intent to the asset whose desired state is expressed."@en .

spa:targetsProperty
    rdf:type owl:ObjectProperty ;
    rdfs:label "targets property"@en ;
    rdfs:domain spa:Intent ;
    rdfs:range spa:Property ;
    rdfs:comment "Links an intent to the property whose desired state is expressed."@en .

spa:addressesFinding
    rdf:type owl:ObjectProperty ;
    rdfs:label "addresses finding"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Finding ;
    rdfs:comment "Links an intent, control, or remediation action to a finding it addresses."@en .

spa:triggeredBy
    rdf:type owl:ObjectProperty ;
    rdfs:label "triggered by"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:Trigger ;
    rdfs:comment "Links an assessment, intent, remediation action, or process to the trigger that initiated it."@en .

spa:triggers
    rdf:type owl:ObjectProperty ;
    owl:inverseOf spa:triggeredBy ;
    rdfs:label "triggers"@en ;
    rdfs:domain spa:Trigger ;
    rdfs:range owl:Thing ;
    rdfs:comment "Links a trigger to the assessment, intent, remediation action, or process it initiates."@en .

spa:hasRemediationAction
    rdf:type owl:ObjectProperty ;
    rdfs:label "has remediation action"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range spa:RemediationAction ;
    rdfs:comment "Links a finding, gap, risk, control, or intent to a remediation action."@en .

spa:mapsToConcept
    rdf:type owl:ObjectProperty ;
    rdfs:label "maps to concept"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range skos:Concept ;
    rdfs:comment "Links an ontology entity to a SKOS concept used for formal taxonomy or framework mapping."@en .

spa:mapsToTMForumConcept
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf spa:mapsToConcept ;
    rdfs:label "maps to TM Forum concept"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range skos:Concept ;
    rdfs:comment "Links an ontology entity to a TM Forum-related SKOS concept."@en .

spa:mapsToLINDDUNConcept
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf spa:mapsToConcept ;
    rdfs:label "maps to LINDDUN concept"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range skos:Concept ;
    rdfs:comment "Links an ontology entity to a LINDDUN privacy threat category SKOS concept."@en .

spa:findings
    rdf:type owl:ObjectProperty ;
    rdfs:label "findings"@en ;
    rdfs:domain spa:AssessmentReport ;
    rdfs:range spa:Finding ;
    rdfs:comment "The structured findings communicated by the report."@en .

spa:provenance
    rdf:type owl:ObjectProperty ;
    rdfs:label "provenance"@en ;
    rdfs:domain spa:AssessmentReport ;
    rdfs:range prov:Entity ;
    rdfs:comment "Provenance of the report: the skill that produced the raw result, the execution timestamp, and a reference to that result."@en .

#################################################################
# Data properties
#################################################################

spa:identifier
    rdf:type owl:DatatypeProperty ;
    rdfs:label "identifier"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:comment "A human-readable or system identifier."@en .

spa:name
    rdf:type owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:comment "A name or short title."@en .

spa:description
    rdf:type owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:comment "A textual description."@en .

spa:createdAt
    rdf:type owl:DatatypeProperty ;
    rdfs:label "created at"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The creation timestamp of an entity."@en .

spa:updatedAt
    rdf:type owl:DatatypeProperty ;
    rdfs:label "updated at"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The last update timestamp of an entity."@en .

spa:startedAt
    rdf:type owl:DatatypeProperty ;
    rdfs:label "started at"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The start timestamp of an activity or lifecycle period."@en .

spa:endedAt
    rdf:type owl:DatatypeProperty ;
    rdfs:label "ended at"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The end timestamp of an activity or lifecycle period."@en .

spa:evidenceCollectedAt
    rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence collected at"@en ;
    rdfs:domain spa:Evidence ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The timestamp at which evidence was collected."@en .

spa:evidenceSourceSystem
    rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence source system"@en ;
    rdfs:domain spa:Evidence ;
    rdfs:range xsd:string ;
    rdfs:comment "The source system, tool, repository, scanner, log source, or platform from which evidence was obtained."@en .

spa:evidenceURI
    rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence URI"@en ;
    rdfs:domain spa:Evidence ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "A URI identifying or locating the evidence item."@en .

spa:evidenceHash
    rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence hash"@en ;
    rdfs:domain spa:Evidence ;
    rdfs:range xsd:string ;
    rdfs:comment "A cryptographic hash or integrity reference for the evidence item."@en .

spa:evidenceFormat
    rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence format"@en ;
    rdfs:domain spa:Evidence ;
    rdfs:range xsd:string ;
    rdfs:comment "The format or media type of the evidence item."@en .

spa:evidenceRetentionPeriod
    rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence retention period"@en ;
    rdfs:domain spa:Evidence ;
    rdfs:range xsd:duration ;
    rdfs:comment "The intended or required retention period for the evidence item."@en .

spa:evidenceValidityUntil
    rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence validity until"@en ;
    rdfs:domain spa:Evidence ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The timestamp until which the evidence item is considered valid or current."@en .

spa:metricValue
    rdf:type owl:DatatypeProperty ;
    rdfs:label "metric value"@en ;
    rdfs:domain spa:Metric ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The numeric value of a metric observation."@en .

spa:metricUnit
    rdf:type owl:DatatypeProperty ;
    rdfs:label "metric unit"@en ;
    rdfs:domain spa:MetricDefinition ;
    rdfs:range xsd:string ;
    rdfs:comment "The unit of measure used by a metric definition."@en .

spa:metricDefinitionText
    rdf:type owl:DatatypeProperty ;
    rdfs:label "metric definition text"@en ;
    rdfs:domain spa:MetricDefinition ;
    rdfs:range xsd:string ;
    rdfs:comment "The textual definition of a metric."@en .

spa:metricTimestamp
    rdf:type owl:DatatypeProperty ;
    rdfs:label "metric timestamp"@en ;
    rdfs:domain spa:Metric ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The timestamp at which the metric value was observed, calculated, or reported."@en .

spa:aggregationPeriod
    rdf:type owl:DatatypeProperty ;
    rdfs:label "aggregation period"@en ;
    rdfs:domain spa:Metric ;
    rdfs:range xsd:duration ;
    rdfs:comment "The time duration over which a metric value was aggregated."@en .

spa:aggregationFunction
    rdf:type owl:DatatypeProperty ;
    rdfs:label "aggregation function"@en ;
    rdfs:domain spa:MetricDefinition ;
    rdfs:range xsd:string ;
    rdfs:comment "The aggregation function associated with a metric definition, such as average, maximum, minimum, count, percentile, or latest."@en .

spa:thresholdValue
    rdf:type owl:DatatypeProperty ;
    rdfs:label "threshold value"@en ;
    rdfs:domain spa:Threshold ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The numeric value of a threshold."@en .

spa:thresholdProvisional
    rdf:type owl:DatatypeProperty ;
    rdfs:label "threshold provisional"@en ;
    rdfs:domain spa:Threshold ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether this threshold value is awaiting confirmation by the party that owns the metric's semantics. Stated as a property rather than only in rdfs:comment so that a normalizer can carry it into every report: a threshold converts a measurement into a severity word, so a reader deciding on the basis of that word needs to know the boundary is unconfirmed. Absent means confirmed. See spa:thresholdProvisionalReason for what is outstanding."@en .

spa:thresholdProvisionalReason
    rdf:type owl:DatatypeProperty ;
    rdfs:label "threshold provisional reason"@en ;
    rdfs:domain spa:Threshold ;
    rdfs:range xsd:string ;
    rdfs:comment "What must be settled before the threshold value can be relied on, and by whom. Phrased for a report reader rather than for the maintainer, because this text is carried into the assessment output verbatim."@en .

spa:metricSemanticsProvisional
    rdf:type owl:DatatypeProperty ;
    rdfs:label "metric semantics provisional"@en ;
    rdfs:domain spa:MetricDefinition ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether how this metric's values are to be read is still awaiting confirmation by the party that owns the measurement. Distinct from spa:thresholdProvisional, which qualifies where a boundary sits: this qualifies what the measured value means before any boundary is applied, so it survives the confirmation of every threshold on the metric and cannot be recorded on one. Absent means confirmed. See spa:metricSemanticsProvisionalReason for what is outstanding."@en .

spa:metricSemanticsProvisionalReason
    rdf:type owl:DatatypeProperty ;
    rdfs:label "metric semantics provisional reason"@en ;
    rdfs:domain spa:MetricDefinition ;
    rdfs:range xsd:string ;
    rdfs:comment "What about the metric's interpretation is outstanding, by whom it would be settled, and which way the normalizer currently reads it. Phrased for a report reader rather than for the maintainer, because this text is carried into the assessment output verbatim."@en .

spa:comparisonOperator
    rdf:type owl:DatatypeProperty ;
    rdfs:label "comparison operator"@en ;
    rdfs:domain spa:Threshold ;
    rdfs:range xsd:string ;
    rdfs:comment "The comparison operator used with a threshold, such as less-than, less-than-or-equal, greater-than, greater-than-or-equal, equal, or not-equal."@en .

spa:conditionExpression
    rdf:type owl:DatatypeProperty ;
    rdfs:label "condition expression"@en ;
    rdfs:domain spa:FulfillmentCondition ;
    rdfs:range xsd:string ;
    rdfs:comment "A declarative expression describing the condition to be satisfied."@en .

spa:intentStatement
    rdf:type owl:DatatypeProperty ;
    rdfs:label "intent statement"@en ;
    rdfs:domain spa:Intent ;
    rdfs:range xsd:string ;
    rdfs:comment "The natural-language or machine-readable declarative statement of desired outcome represented by the intent."@en .

spa:sourceReference
    rdf:type owl:DatatypeProperty ;
    rdfs:label "source reference"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:comment "A textual reference to an external source, clause, article, control identifier, or document section."@en .

spa:reportType
    rdf:type owl:DatatypeProperty ;
    rdfs:label "report type"@en ;
    rdfs:domain spa:AssessmentReport ;
    rdfs:range xsd:string ;
    rdfs:comment "The report schema identifier, e.g. \"tmfIntentReport.v1\"."@en .

spa:status
    rdf:type owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:domain spa:AssessmentReport ;
    rdfs:range xsd:string ;
    rdfs:comment "The terminal status of the assessment as reported: SUCCESS, FAILED, or INCONCLUSIVE."@en .

spa:summary
    rdf:type owl:DatatypeProperty ;
    rdfs:label "summary"@en ;
    rdfs:domain spa:AssessmentReport ;
    rdfs:range xsd:string ;
    rdfs:comment "A short human-readable verdict summarising the assessment outcome."@en .

spa:recommendations
    rdf:type owl:DatatypeProperty ;
    rdfs:label "recommendations"@en ;
    rdfs:domain spa:AssessmentReport ;
    rdfs:range xsd:string ;
    rdfs:comment "Recommended remediation actions, one literal per recommendation."@en .

spa:intentId
    rdf:type owl:DatatypeProperty ;
    rdfs:label "intent id"@en ;
    rdfs:domain spa:AssessmentReport ;
    rdfs:range xsd:string ;
    rdfs:comment "Identifier of the intent this report fulfils, carried over from the originating intent."@en .

spa:metricIdentifier
    rdf:type owl:DatatypeProperty ;
    rdfs:label "metric identifier"@en ;
    rdfs:domain spa:MetricDefinition ;
    rdfs:range xsd:string ;
    rdfs:comment "A stable machine-readable key for a metric definition, used by skill normalizers to bind a raw tool output column to this definition."@en .

spa:higherIsWorse
    rdf:type owl:DatatypeProperty ;
    rdfs:label "higher is worse"@en ;
    rdfs:domain spa:MetricDefinition ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether a larger metric value indicates a worse outcome. Stated explicitly because the polarity of privacy and security metrics is not inferable from the value alone: an attack advantage worsens as it rises, while an attacker-accuracy score can worsen as it falls away from chance level."@en .

spa:derivedFromMetric
    rdf:type owl:ObjectProperty ;
    rdfs:label "derived from metric"@en ;
    rdfs:domain spa:MetricDefinition ;
    rdfs:range spa:MetricDefinition ;
    rdfs:comment "Marks a metric definition as an algebraic restatement of another, so reporting can avoid presenting it as independent corroborating evidence."@en .

spa:derivationExpression
    rdf:type owl:DatatypeProperty ;
    rdfs:label "derivation expression"@en ;
    rdfs:domain spa:MetricDefinition ;
    rdfs:range xsd:string ;
    rdfs:comment "The expression by which a derived metric definition is computed from the metric it is derived from."@en .

spa:SweepDimension
    rdf:type owl:Class ;
    rdfs:label "Sweep Dimension"@en ;
    rdfs:comment "A varied input parameter of a parameter-sweep assessment, along which metric observations are indexed. Dimensions are what make a sweep result a matrix rather than a list, and they are the axes along which reporting aggregates."@en .

spa:hasDimension
    rdf:type owl:ObjectProperty ;
    rdfs:label "has dimension"@en ;
    rdfs:domain spa:Metric ;
    rdfs:range spa:SweepDimension ;
    rdfs:comment "Links a metric observation to the sweep dimension values under which it was observed."@en .

spa:dimensionName
    rdf:type owl:DatatypeProperty ;
    rdfs:label "dimension name"@en ;
    rdfs:domain spa:SweepDimension ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of a swept input parameter, such as a learning rate or batch size."@en .

spa:dimensionValue
    rdf:type owl:DatatypeProperty ;
    rdfs:label "dimension value"@en ;
    rdfs:domain spa:SweepDimension ;
    rdfs:range xsd:string ;
    rdfs:comment "The value of a swept input parameter for one observation, held as a string so heterogeneous parameter types share one representation."@en .

spa:scopeLimitation
    rdf:type owl:DatatypeProperty ;
    rdfs:label "scope limitation"@en ;
    rdfs:domain spa:AssessmentReport ;
    rdfs:range xsd:string ;
    rdfs:comment "A stated boundary on what the assessment establishes: a configuration not exercised, a degenerate input condition, or an attack class not attempted. One literal per limitation. Required reading for compliance audiences, for whom the untested surface matters as much as the findings."@en .

#################################################################
# Rendition properties
#
# A rendition is a projection of the canonical fact model for one audience.
# These properties describe the projection itself — which profile produced it,
# what it disclosed, and what it left out — so that the rendition can be
# validated and reconciled against the assessment it came from without
# re-reading the facts.
#################################################################

spa:renditionProfile
    rdf:type owl:DatatypeProperty ;
    rdfs:label "rendition profile"@en ;
    rdfs:domain spa:ReportRendition ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the audience profile that produced this rendition: technical, management, compliance, or external."@en .

spa:renditionResolvedBy
    rdf:type owl:DatatypeProperty ;
    rdfs:label "rendition resolved by"@en ;
    rdfs:domain spa:ReportRendition ;
    rdfs:range xsd:string ;
    rdfs:comment "How the profile was chosen — from the intent's actor role, an explicit reporting profile request, an API override, or the default. Recorded because a rendition's detail level is only defensible if the basis for choosing it is visible."@en .

spa:disclosureClass
    rdf:type owl:ObjectProperty ;
    rdfs:label "disclosure class"@en ;
    rdfs:domain spa:ReportRendition ;
    rdfs:range spa:DisclosureClass ;
    rdfs:comment "How far this rendition may travel. The effective content of a rendition is the intersection of what its audience needs and what its disclosure class permits, so the class is a property of the artifact rather than of the reader."@en .

spa:numericDisclosure
    rdf:type owl:DatatypeProperty ;
    rdfs:label "numeric disclosure"@en ;
    rdfs:domain spa:ReportRendition ;
    rdfs:range xsd:string ;
    rdfs:comment "Whether measured values appear exactly, in bands, or not at all: exact, banded, or verdictOnly. Stated so a reader knows whether an absent figure was suppressed or never measured."@en .

spa:canonicalWorstSeverity
    rdf:type owl:DatatypeProperty ;
    rdfs:label "canonical worst severity"@en ;
    rdfs:domain spa:ReportRendition ;
    rdfs:range xsd:string ;
    rdfs:comment "The worst severity in the fact model this rendition was projected from, carried even when the rendition suppresses the findings that produced it. This is what makes a reduced rendition reconcilable against the assessment: a management view showing two findings and a canonical count of nine is transparently a selection, not a complete list."@en .

spa:canonicalFindingCount
    rdf:type owl:DatatypeProperty ;
    rdfs:label "canonical finding count"@en ;
    rdfs:domain spa:ReportRendition ;
    rdfs:range xsd:integer ;
    rdfs:comment "How many findings the underlying fact model held, irrespective of how many this rendition shows."@en .

spa:findingsOmitted
    rdf:type owl:DatatypeProperty ;
    rdfs:label "findings omitted"@en ;
    rdfs:domain spa:ReportRendition ;
    rdfs:range xsd:integer ;
    rdfs:comment "How many findings this rendition dropped, through a severity floor or a per-report cap. Reported rather than silently applied: an omission a reader cannot see is indistinguishable from an absence."@en .

spa:renditionReleased
    rdf:type owl:DatatypeProperty ;
    rdfs:label "rendition released"@en ;
    rdfs:domain spa:ExternalStatement ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether an external statement was produced. False means every gate was evaluated and at least one was not satisfied; the reasons are carried in spa:withheldBecause. The honest external output for an assessment that found a problem is nothing, and this records that nothing was produced rather than leaving the absence unexplained."@en .

spa:withheldBecause
    rdf:type owl:DatatypeProperty ;
    rdfs:label "withheld because"@en ;
    rdfs:domain spa:ExternalStatement ;
    rdfs:range xsd:string ;
    rdfs:comment "One reason an external statement was not produced, in prose. One literal per unsatisfied gate."@en .

spa:externalScopeStatement
    rdf:type owl:DatatypeProperty ;
    rdfs:label "external scope statement"@en ;
    rdfs:domain spa:ExternalStatement ;
    rdfs:range xsd:string ;
    rdfs:comment "A boundary on the assessment, phrased for a reader outside the organisation. Distinct from spa:scopeLimitation, which names the paths, parameter values and identifiers that make a limitation checkable internally and must not leave. Written by the normalizer rather than derived from the internal wording: a normalizer opts in by supplying text it is willing to have quoted to a customer."@en .

#################################################################
# Validity and approval of a released statement
#
# An external statement makes a claim about a component at a moment. The
# component then keeps changing, so the claim decays while the artifact does
# not: a PDF from eighteen months ago reads exactly like one from this morning.
# These properties bound the claim in time and record who agreed to make it.
#
# spa:evidenceValidityUntil is deliberately not reused here. Its rdfs:domain is
# spa:Evidence, so asserting it on a statement would type the statement as
# evidence for itself — the artifact is a claim derived from evidence, not an
# item of it, and a reasoner stronger than the one this repository runs would
# draw exactly that unwanted conclusion.
#################################################################

spa:assessedOn
    rdf:type owl:DatatypeProperty ;
    rdfs:label "assessed on"@en ;
    rdfs:domain spa:ReportRendition ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "When the assessment this rendition reports on was performed. Required before an external statement may be released, because a validity period has to be measured from somewhere: an undated statement cannot be shown to have expired and so never does."@en .

spa:statementValidUntil
    rdf:type owl:DatatypeProperty ;
    rdfs:label "statement valid until"@en ;
    rdfs:domain spa:ExternalStatement ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The moment after which this statement no longer stands and must be re-established by a fresh assessment. Derived from spa:assessedOn plus spa:statementValidityPeriod rather than chosen per statement, so that the expiry of two statements can be compared."@en .

spa:statementValidityPeriod
    rdf:type owl:DatatypeProperty ;
    rdfs:label "statement validity period"@en ;
    rdfs:domain spa:ExternalStatement ;
    rdfs:range xsd:duration ;
    rdfs:comment "How long a released statement stands before it must be re-established. Carried on the artifact rather than left in the code that produced it, so a reader can see the rule that produced the expiry date and not only the date."@en .

spa:requiresApprovalBeforeRelease
    rdf:type owl:DatatypeProperty ;
    rdfs:label "requires approval before release"@en ;
    rdfs:domain spa:ExternalStatement ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether a human must agree before this statement leaves the organisation. Stating the requirement is not the same as meeting it: see spa:approvalState, which records whether it was actually met. A requirement advertised without a corresponding state reads as a control while being none."@en .

spa:approvalState
    rdf:type owl:DatatypeProperty ;
    rdfs:label "approval state"@en ;
    rdfs:domain spa:ExternalStatement ;
    rdfs:range xsd:string ;
    rdfs:comment "Whether release has been approved: pending or approved. There is no rejected state — a refused release is simply not released, and the reason belongs in spa:withheldBecause where every other unmet condition is recorded."@en .

spa:approvedBy
    rdf:type owl:DatatypeProperty ;
    rdfs:label "approved by"@en ;
    rdfs:domain spa:ExternalStatement ;
    rdfs:range xsd:string ;
    rdfs:comment "The person or role that approved release. Named rather than implied, because an approval nobody is attached to cannot be questioned afterwards."@en .

spa:approvalRecordedAt
    rdf:type owl:DatatypeProperty ;
    rdfs:label "approval recorded at"@en ;
    rdfs:domain spa:ExternalStatement ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "When the approval was given. Distinct from spa:assessedOn: an approval given long after the assessment was performed was given against a stale picture, and the gap is only visible if both are recorded."@en .

spa:approvalReference
    rdf:type owl:DatatypeProperty ;
    rdfs:label "approval reference"@en ;
    rdfs:domain spa:ExternalStatement ;
    rdfs:range xsd:string ;
    rdfs:comment "An external record of the approval decision — a ticket, change request, or minute. Optional, and the one part of the approval that InTrust cannot check."@en .

spa:DisclosureClass
    rdf:type owl:Class ;
    rdfs:label "Disclosure Class"@en ;
    rdfs:comment "How far an artifact may travel: within the assessing team, within the organisation, or outside it."@en .

spa:DisclosureInternal
    rdf:type owl:NamedIndividual , spa:DisclosureClass ;
    rdfs:label "Internal disclosure"@en ;
    rdfs:comment "May carry evidence, file paths, and raw tool output. For the readers who will act on the finding."@en .

spa:DisclosureConfidential
    rdf:type owl:NamedIndividual , spa:DisclosureClass ;
    rdfs:label "Confidential disclosure"@en ;
    rdfs:comment "May carry measured figures and findings, but not the evidence snippets or raw output that would reproduce them."@en .

spa:DisclosureExternal
    rdf:type owl:NamedIndividual , spa:DisclosureClass ;
    rdfs:label "External disclosure"@en ;
    rdfs:comment "May leave the organisation. Built by allowlist, gated on release conditions, and carrying no target identifiers, paths, or measurements."@en .

spa:criterionKey
    rdf:type owl:DatatypeProperty ;
    rdfs:label "criterion key"@en ;
    rdfs:domain spa:RegulatorySource ;
    rdfs:range xsd:string ;
    rdfs:comment "A short token by which an intent may name this regulatory source in its criteria list, such as \"gdpr\". Declared so that criterion resolution is a lookup against the ontology rather than string matching in code."@en .

spa:evaluatedBySkill
    rdf:type owl:DatatypeProperty ;
    rdfs:label "evaluated by skill"@en ;
    rdfs:domain spa:Requirement ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of an InTrust skill able to produce evidence bearing on this requirement. A requirement with no such skill is one the framework cannot currently evaluate, which is what makes an honest coverage statement possible: naming a criterion in an intent does not mean the criterion was assessed."@en .

spa:addressesPrivacyThreatCategory
    rdf:type owl:ObjectProperty ;
    rdfs:label "addresses privacy threat category"@en ;
    rdfs:domain spa:Requirement ;
    rdfs:range spa:PrivacyThreatCategory ;
    rdfs:comment "Links a requirement to the privacy threat category it guards against. Distinct from spa:hasPrivacyThreatCategory, which classifies a threat itself: a requirement is not a threat, so the two must not share a property."@en .

#################################################################
# SKOS concept schemes for mappings
#################################################################

spa:TMForumSecurityPropertyScheme
    rdf:type skos:ConceptScheme ;
    rdfs:label "TM Forum Security Property Concept Scheme"@en ;
    skos:prefLabel "TM Forum Security Property Concept Scheme"@en ;
    dcterms:source "TM Forum TR 2921" ;
    skos:definition "A SKOS concept scheme for TM Forum TR 2921-inspired security property mappings used by the SPA ontology."@en .

spa:LINDDUNThreatCategoryScheme
    rdf:type skos:ConceptScheme ;
    rdfs:label "LINDDUN Privacy Threat Category Concept Scheme"@en ;
    skos:prefLabel "LINDDUN Privacy Threat Category Concept Scheme"@en ;
    dcterms:source "LINDDUN privacy threat modeling framework" ;
    skos:definition "A SKOS concept scheme for LINDDUN privacy threat category mappings used by the SPA ontology."@en .

#################################################################
# TM Forum-inspired security property individuals and mappings
#################################################################

spa:Confidentiality
    rdf:type owl:NamedIndividual , spa:SecurityProperty , skos:Concept ;
    rdfs:label "Confidentiality"@en ;
    skos:prefLabel "Confidentiality"@en ;
    skos:inScheme spa:TMForumSecurityPropertyScheme ;
    skos:definition "The property that information is not made available or disclosed to unauthorized individuals, entities, or processes."@en ;
    skos:closeMatch <https://www.tmforum.org/resources/reference/tr2921/#Confidentiality> .

spa:Integrity
    rdf:type owl:NamedIndividual , spa:SecurityProperty , skos:Concept ;
    rdfs:label "Integrity"@en ;
    skos:prefLabel "Integrity"@en ;
    skos:inScheme spa:TMForumSecurityPropertyScheme ;
    skos:definition "The property of accuracy and completeness of assets, data, or processing."@en ;
    skos:closeMatch <https://www.tmforum.org/resources/reference/tr2921/#Integrity> .

spa:Availability
    rdf:type owl:NamedIndividual , spa:SecurityProperty , skos:Concept ;
    rdfs:label "Availability"@en ;
    skos:prefLabel "Availability"@en ;
    skos:inScheme spa:TMForumSecurityPropertyScheme ;
    skos:definition "The property of being accessible and usable on demand by an authorized entity."@en ;
    skos:closeMatch <https://www.tmforum.org/resources/reference/tr2921/#Availability> .

spa:Accountability
    rdf:type owl:NamedIndividual , spa:SecurityProperty , skos:Concept ;
    rdfs:label "Accountability"@en ;
    skos:prefLabel "Accountability"@en ;
    skos:inScheme spa:TMForumSecurityPropertyScheme ;
    skos:definition "The property that actions of an entity can be traced uniquely to that entity."@en ;
    skos:closeMatch <https://www.tmforum.org/resources/reference/tr2921/#Accountability> .

spa:Authentication
    rdf:type owl:NamedIndividual , spa:SecurityProperty , skos:Concept ;
    rdfs:label "Authentication"@en ;
    skos:prefLabel "Authentication"@en ;
    skos:inScheme spa:TMForumSecurityPropertyScheme ;
    skos:definition "The property or process of verifying the claimed identity of an entity."@en ;
    skos:closeMatch <https://www.tmforum.org/resources/reference/tr2921/#Authentication> .

spa:Authorization
    rdf:type owl:NamedIndividual , spa:SecurityProperty , skos:Concept ;
    rdfs:label "Authorization"@en ;
    skos:prefLabel "Authorization"@en ;
    skos:inScheme spa:TMForumSecurityPropertyScheme ;
    skos:definition "The property or process of determining whether an authenticated entity is permitted to access a resource or perform an action."@en ;
    skos:closeMatch <https://www.tmforum.org/resources/reference/tr2921/#Authorization> .

spa:NonRepudiation
    rdf:type owl:NamedIndividual , spa:SecurityProperty , skos:Concept ;
    rdfs:label "Non-repudiation"@en ;
    skos:prefLabel "Non-repudiation"@en ;
    skos:inScheme spa:TMForumSecurityPropertyScheme ;
    skos:definition "The property that an entity cannot deny having performed an action or transaction."@en ;
    skos:closeMatch <https://www.tmforum.org/resources/reference/tr2921/#NonRepudiation> .

#################################################################
# LINDDUN privacy threat category individuals and mappings
#################################################################

spa:Linkability
    rdf:type owl:NamedIndividual , spa:PrivacyThreatCategory , skos:Concept ;
    rdfs:label "Linkability"@en ;
    skos:prefLabel "Linkability"@en ;
    skos:inScheme spa:LINDDUNThreatCategoryScheme ;
    skos:definition "A privacy threat category concerning the ability to sufficiently distinguish whether items of interest are related."@en ;
    skos:exactMatch <https://linddun.org/threat-tree/#Linkability> .

spa:Identifiability
    rdf:type owl:NamedIndividual , spa:PrivacyThreatCategory , skos:Concept ;
    rdfs:label "Identifiability"@en ;
    skos:prefLabel "Identifiability"@en ;
    skos:inScheme spa:LINDDUNThreatCategoryScheme ;
    skos:definition "A privacy threat category concerning the ability to sufficiently identify a data subject."@en ;
    skos:exactMatch <https://linddun.org/threat-tree/#Identifiability> .

spa:LINDDUNNonRepudiation
    rdf:type owl:NamedIndividual , spa:PrivacyThreatCategory , skos:Concept ;
    rdfs:label "LINDDUN Non-repudiation"@en ;
    skos:prefLabel "Non-repudiation"@en ;
    skos:inScheme spa:LINDDUNThreatCategoryScheme ;
    skos:definition "A privacy threat category concerning the inability of a data subject to deny claims or actions in a privacy-relevant context."@en ;
    skos:exactMatch <https://linddun.org/threat-tree/#NonRepudiation> .

spa:Detectability
    rdf:type owl:NamedIndividual , spa:PrivacyThreatCategory , skos:Concept ;
    rdfs:label "Detectability"@en ;
    skos:prefLabel "Detectability"@en ;
    skos:inScheme spa:LINDDUNThreatCategoryScheme ;
    skos:definition "A privacy threat category concerning the ability to sufficiently distinguish whether an item of interest exists."@en ;
    skos:exactMatch <https://linddun.org/threat-tree/#Detectability> .

spa:DisclosureOfInformation
    rdf:type owl:NamedIndividual , spa:PrivacyThreatCategory , skos:Concept ;
    rdfs:label "Disclosure of Information"@en ;
    skos:prefLabel "Disclosure of Information"@en ;
    skos:inScheme spa:LINDDUNThreatCategoryScheme ;
    skos:definition "A privacy threat category concerning unauthorized or inappropriate disclosure of information."@en ;
    skos:exactMatch <https://linddun.org/threat-tree/#DisclosureOfInformation> .

spa:Unawareness
    rdf:type owl:NamedIndividual , spa:PrivacyThreatCategory , skos:Concept ;
    rdfs:label "Unawareness"@en ;
    skos:prefLabel "Unawareness"@en ;
    skos:inScheme spa:LINDDUNThreatCategoryScheme ;
    skos:definition "A privacy threat category concerning insufficient awareness, transparency, or understanding by data subjects."@en ;
    skos:exactMatch <https://linddun.org/threat-tree/#Unawareness> .

spa:NonCompliance
    rdf:type owl:NamedIndividual , spa:PrivacyThreatCategory , skos:Concept ;
    rdfs:label "Non-compliance"@en ;
    skos:prefLabel "Non-compliance"@en ;
    skos:inScheme spa:LINDDUNThreatCategoryScheme ;
    skos:definition "A privacy threat category concerning violation of legal, regulatory, contractual, policy, or organizational privacy obligations."@en ;
    skos:exactMatch <https://linddun.org/threat-tree/#NonCompliance> .

#################################################################
# Privacy property individuals
# LINDDUN is intentionally modeled as privacy threat categories,
# not as privacy properties.
#################################################################

spa:DataMinimization
    rdf:type owl:NamedIndividual , spa:PrivacyProperty ;
    rdfs:label "Data minimization"@en ;
    rdfs:comment "The property that personal data collection and processing are limited to what is necessary for the stated purpose."@en .

spa:PurposeLimitation
    rdf:type owl:NamedIndividual , spa:PrivacyProperty ;
    rdfs:label "Purpose limitation"@en ;
    rdfs:comment "The property that personal data is collected for specified, explicit, and legitimate purposes and not further processed incompatibly."@en .

spa:Transparency
    rdf:type owl:NamedIndividual , spa:PrivacyProperty ;
    rdfs:label "Transparency"@en ;
    rdfs:comment "The property that processing is understandable, visible, and communicated appropriately to affected data subjects."@en .

spa:StorageLimitation
    rdf:type owl:NamedIndividual , spa:PrivacyProperty ;
    rdfs:label "Storage limitation"@en ;
    rdfs:comment "The property that personal data is not kept longer than necessary."@en .

spa:ConsentManagement
    rdf:type owl:NamedIndividual , spa:PrivacyProperty ;
    rdfs:label "Consent management"@en ;
    rdfs:comment "The property that consent is collected, managed, withdrawn, and evidenced appropriately where consent is the lawful basis."@en .

