spa:SeverityHigh
    rdf:type owl:NamedIndividual , spa:Severity ;
    rdfs:label "High severity"@en .

spa:SeverityCritical
    rdf:type owl:NamedIndividual , spa:Severity ;
    rdfs:label "Critical severity"@en .

spa:LikelihoodLow
    rdf:type owl:NamedIndividual , spa:Likelihood ;
    rdfs:label "Low likelihood"@en .

spa:LikelihoodMedium
    rdf:type owl:NamedIndividual , spa:Likelihood ;
    rdfs:label "Medium likelihood"@en .

spa:LikelihoodHigh
    rdf:type owl:NamedIndividual , spa:Likelihood ;
    rdfs:label "High likelihood"@en .

spa:ImpactLow
    rdf:type owl:NamedIndividual , spa:Impact ;
    rdfs:label "Low impact"@en .

spa:ImpactMedium
    rdf:type owl:NamedIndividual , spa:Impact ;
    rdfs:label "Medium impact"@en .

spa:ImpactHigh
    rdf:type owl:NamedIndividual , spa:Impact ;
    rdfs:label "High impact"@en .

spa:RiskLevelLow
    rdf:type owl:NamedIndividual , spa:RiskLevel ;
