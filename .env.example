DATABASE_TYPE=sqlite
INTRUST_STORAGE_DIR=storage
INTRUST_LOG_DIR=logs
SQLITE_DATABASE_FILE=intrust.db

MYSQL_DATABASE=intrust
MYSQL_USER=intrust
MYSQL_PASSWORD=intrustpass
MYSQL_ROOT_PASSWORD=rootpass

# LLM used by the assessment agent, report composition and summaries.
# Gemini via ADK / google-genai; credentials are read from the environment.
MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Per-audience prose summaries. Set to 0 to skip them: renditions are
# deterministic and need no model, so a service without a reachable model
# still serves reports, just without the narrative.
INTRUST_RENDITION_SUMMARY=1
# Optional. Summaries use the same model as the assessment agent
# (MODEL above) unless this is set.
#RENDITION_SUMMARY_MODEL=

# MIA service endpoints used by tools/mia_assessment.py
MIA_INITIATE_URL=http://<mia-host>:<port>/initiate
MIA_RETRIEVE_URL=http://<mia-host>:<port>/retrieve
